+        (self.runs/self.name/'order.txt').write_text('drafted-rule--002 given--001')
+        self.assertNotEqual(self.run_resume().returncode,0)
+        self.assertFalse((self.runs/self.name/'generate-count').exists())
+
+    def test_truncated_or_wrong_digest_transport_does_not_publish_partial_result(self):
+        run = self.remote/self.name
+        source = self.runs/self.name/'results/given--001'
