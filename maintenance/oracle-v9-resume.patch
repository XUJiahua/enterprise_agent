+  echo "$(date -u +%FT%TZ) $run generate rc=$rc" >> "$ROOT/resume.log"
+  case "$rc" in 0|3) ;; *) exit "$rc" ;; esac
+  # Resend every terminal result, including results whose earlier transfer was
+  # interrupted. The receiver accepts identical data and never overwrites a
+  # different terminal result. kiro-home is excluded on both digest and tar.
+  for t in $ORDER; do
+    state=$(python3 "$SUPPORT" classify --run "$D" --trial "$t")
+    case "$state" in terminal|preflight) ;; *) continue ;; esac
+    digest=$(python3 "$SUPPORT" fingerprint --run "$D" --trial "$t")
+    tar cf - --exclude=kiro-home -C "$D/results" "$t" | \
+      remote receive --run "$RH" --trial "$t" --digest "$digest" >> "$ROOT/resume.log" 2>&1
+  done
+  # Keep old derived summaries, so the frozen evaluator can write a fresh one
+  # without overwriting a previous result or silently failing its exclusive save.
+  remote archive-summary --run "$RH" >> "$ROOT/resume.log" 2>&1
+  "$HERE/host_db.sh" up "$slot" "$H" >> "$ROOT/resume.log" 2>&1
+  db_started=1
+  "$HERE/host_evaluate.sh" "$run" "$slot" "$H" >> "$ROOT/eval-resume-$run.log" 2>&1
+  remote final-status --run "$RH" >> "$ROOT/resume.log" 2>&1
   echo "$(date -u +%FT%TZ) $run resumed+evaluated" >> "$ROOT/resume.log"
+)
+# Batch at most three lanes and reuse slots 1..3. The old increasing counter
+# eventually passed slot 5 to a host_db helper that only accepts slots 1..4.
+pids=(); failures=0; slot=0
+finish_batch() {
+  local pid
+  for pid in "${pids[@]}"; do if wait "$pid"; then :; else failures=1; fi; done
+  pids=(); slot=0
 }
