+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tarfile
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('resume_support', ROOT / 'scripts/resume_support.py')
+support = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(support)
+
+
+def write(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value))
+
+
+def blocked(run, trial='drafted-rule--002', marker='original'):
+    result = run / 'results' / trial
+    result.mkdir(parents=True)
+    write(result / 'preflight.json', {'ready': False, 'invocation': {'status': 'budget-exceeded', 'turn_started': True}})
+    (result / 'probe').mkdir()
+    (result / 'probe/events.jsonl').write_text(marker)
+
+
+def terminal(run, trial='given--001'):
+    result = run / 'results' / trial
+    result.mkdir(parents=True)
+    write(result / 'outcome.json', {'trial': {'id': trial}, 'outcome': 'generated'})
+    write(result / 'receipt.json', {'trial': {'id': trial}})
+    (result / 'candidate.bundle').write_bytes(b'original candidate bundle')
+    (result / 'kiro-home').mkdir()
+    (result / 'kiro-home/session').write_text('not transported')
+
+
+GENERATOR = '''#!/usr/bin/env python3
+import json,os,sys
+from pathlib import Path
+run=Path(sys.argv[1]);count=run/'generate-count'
+n=int(count.read_text())+1 if count.exists() else 1;count.write_text(str(n))
+if os.environ.get('GENERATE_FAIL'):sys.exit(7)
+for t in json.loads((run/'plan.json').read_text())['trials']:
+ p=run/'results'/t['id']
+ if p.exists():continue
+ p.mkdir(parents=True)
+ if n<=int(os.environ.get('GEN_BLOCKS','0')):
+  (p/'preflight.json').write_text(json.dumps({'ready':False}))
+  (p/'probe').mkdir();(p/'probe/events.jsonl').write_text('blocked-'+str(n));sys.exit(3)
+ (p/'outcome.json').write_text(json.dumps({'trial':t,'outcome':'generated'}))
+ (p/'receipt.json').write_text(json.dumps({'trial':t}))
+ (p/'candidate.bundle').write_bytes(b'new candidate')
+ with (run/'actual-generations').open('a') as f:f.write(t['id']+'\\n')
+'''
+DATABASE = '''#!/usr/bin/env python3
+import json,os,sys
+with open(os.environ['DB_LOG'],'a') as f:f.write(json.dumps(sys.argv[1:])+'\\n')
+assert sys.argv[2] in ['1','2','3']
+if sys.argv[1]=='up' and os.environ.get('DB_FAIL'):sys.exit(8)
+'''
+EVALUATOR = '''#!/usr/bin/env python3
+import json,os,sys
+from pathlib import Path
+run=Path(os.environ['ORACLE_REMOTE_RUNS_ROOT'])/sys.argv[1]
+if os.environ.get('EVAL_FAIL'):sys.exit(6)
+for t in json.loads((run/'plan.json').read_text())['trials']:
+ p=run/'results'/t['id'];out=run/'evaluations'/t['id']/'result.json'
+ if not (p/'receipt.json').exists() or out.exists() or os.environ.get('EVAL_SKIP'):continue
+ out.parent.mkdir(parents=True,exist_ok=True)
+ out.write_text(json.dumps({'trial':t,'outcome':'passed'}))
+with (run/'summary.json').open('x') as f:json.dump({'synthetic':True},f)
+'''
+SSH = '''#!/usr/bin/env python3
+import os,shlex,subprocess,sys
+args=shlex.split(sys.argv[-1]);mode=args[3]
+if os.environ.get('SSH_FAIL_'+mode.upper().replace('-','_')):sys.exit(9)
+sys.exit(subprocess.run(['bash','-c',sys.argv[-1]]).returncode)
+'''
+
+
+class ResumeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='v9-resume-')
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.runs = self.root / 'local'; self.runs.mkdir()
+        self.remote = self.root / 'remote'; self.remote.mkdir()
+        self.scripts = self.root / 'scripts'; self.scripts.mkdir()
+        self.bin = self.root / 'bin'; self.bin.mkdir()
+        for name in ['resume_v9.sh', 'resume_support.py']:
+            shutil.copy(ROOT / 'scripts' / name, self.scripts / name)
+        for path, text in [(self.scripts/'generate.sh', GENERATOR), (self.scripts/'host_db.sh', DATABASE),
+                           (self.scripts/'host_evaluate.sh', EVALUATOR), (self.bin/'ssh', SSH)]:
+            path.write_text(text); path.chmod(0o755)
+        self.env = {**os.environ, 'PATH':str(self.bin)+os.pathsep+os.environ['PATH'], 'ORACLE_HOST':'synthetic-host',
+                    'ORACLE_REMOTE_RUNS_ROOT':str(self.remote), 'DB_LOG':str(self.root/'db.log')}
+        self.name = 'v9-synthetic'
+        self.make_lane(self.name)
+
+    def make_lane(self, name):
+        for parent in [self.runs, self.remote]:
+            lane = parent / name; lane.mkdir()
+            ids = ['given--001', 'drafted-rule--002']
+            write(lane / 'plan.json', {'trials':[{'id':t} for t in ids]})
+            (lane / 'order.txt').write_text(' '.join(ids))
+            terminal(lane); blocked(lane)
+            if parent == self.remote:
+                shutil.rmtree(lane/'results/given--001/kiro-home')
+
+    def run_resume(self, names=None, **env):
+        return subprocess.run(['bash', str(self.scripts/'resume_v9.sh'), str(self.runs), *(names or [self.name])],
+                              env={**self.env, **env}, capture_output=True, text=True, timeout=60)
+
+    def assert_clean_locks(self):
+        self.assertFalse(list(self.runs.glob('slot-*')))
+        self.assertFalse(list(self.runs.glob('*/.resume-v9.lock')))
+
+    def test_three_blocks_preserve_local_remote_probes_and_first_generation(self):
+        original = (self.runs/self.name/'results/given--001/candidate.bundle').read_bytes()
+        for n in range(3):
+            proc = self.run_resume(GEN_BLOCKS='2')
+            self.assertEqual(proc.returncode == 0, n == 2, proc.stderr)
+            self.assert_clean_locks()
+        for parent in [self.runs, self.remote]:
+            lane = parent/self.name
+            probes = sorted(lane.glob('preflight-blocked-*/drafted-rule--002--*/result/probe/events.jsonl'))
+            self.assertEqual([p.read_text() for p in probes], ['original','blocked-1','blocked-2'])
+            self.assertEqual((lane/'results/given--001/candidate.bundle').read_bytes(), original)
+        lane = self.runs/self.name
+        self.assertEqual((lane/'actual-generations').read_text().splitlines(), ['drafted-rule--002'])
+        self.assertEqual(support.final_status(self.remote/self.name), {'planned':2,'observed':2,'unmeasured':0,'pending':0})
+        self.assertFalse((self.remote/self.name/'results/given--001/kiro-home').exists())
+        self.assertEqual(len(list((self.remote/self.name/'summary-before-resume').glob('summary--*/summary.json'))),2)
+
+    def test_remote_archive_failure_stops_before_generation(self):
+        p = self.run_resume(SSH_FAIL_ARCHIVE='1')
+        self.assertNotEqual(p.returncode, 0)
+        self.assertFalse((self.runs/self.name/'generate-count').exists())
+        self.assertTrue((self.runs/self.name/'results/drafted-rule--002/preflight.json').exists())
+        self.assertNotIn('RESUME DONE', (self.runs/'resume.log').read_text())
+        self.assert_clean_locks()
+
+    def test_local_archive_failure_after_remote_move_can_resume_without_overwrite(self):
+        lane = self.runs/self.name
+        day = support.datetime.now(support.timezone.utc).strftime('%Y%m%d')
+        conflict = lane/('preflight-blocked-'+day); conflict.write_text('occupied')
+        p = self.run_resume()
+        self.assertNotEqual(p.returncode,0)
+        self.assertFalse((lane/'generate-count').exists())
+        self.assertTrue((lane/'results/drafted-rule--002/preflight.json').exists())
+        self.assertEqual(len(list((self.remote/self.name).glob('preflight-blocked-*/drafted-rule--002--*/result'))),1)
+        conflict.unlink()
+        self.assertEqual(self.run_resume().returncode,0)
+        self.assertEqual(len(list((self.remote/self.name).glob('preflight-blocked-*/drafted-rule--002--*/result'))),1)
+
+    def test_partial_generation_or_stage_is_never_archived(self):
+        lane = self.runs/self.name
+        for name in ['generation','draft','adapter','receipt.json']:
+            with self.subTest(name=name):
+                marker = lane/'results/drafted-rule--002'/name;marker.touch()
+                p = self.run_resume()
+                self.assertNotEqual(p.returncode,0)
+                self.assertFalse((lane/'generate-count').exists())
+                self.assertTrue(marker.exists()); marker.unlink()
+                self.assert_clean_locks()
+
+    def test_transfer_failure_recovers_without_regenerating_terminal_results(self):
+        p = self.run_resume(SSH_FAIL_RECEIVE='1')
+        self.assertNotEqual(p.returncode,0)
+        self.assertFalse((self.root/'db.log').exists())
+        self.assertEqual(self.run_resume().returncode,0)
+        self.assertEqual((self.runs/self.name/'actual-generations').read_text().splitlines(),['drafted-rule--002'])
+        self.assert_clean_locks()
+
+    def test_different_terminal_data_is_not_overwritten(self):
+        remote = self.remote/self.name/'results/given--001/candidate.bundle'
+        remote.write_bytes(b'other immutable candidate')
+        self.assertNotEqual(self.run_resume().returncode,0)
+        self.assertEqual(remote.read_bytes(),b'other immutable candidate')
+        self.assertFalse((self.root/'db.log').exists())
+
+    def test_more_than_three_lanes_reuse_only_slots_one_to_three(self):
+        names = [self.name]+['v9-synthetic-'+str(n) for n in range(1,7)]
+        for name in names[1:]:self.make_lane(name)
+        p = self.run_resume(names)
+        self.assertEqual(p.returncode,0,p.stderr)
+        events = [json.loads(s) for s in (self.root/'db.log').read_text().splitlines()]
+        self.assertEqual(len([e for e in events if e[0]=='up']),7)
+        self.assertEqual(len([e for e in events if e[0]=='down']),7)
+        self.assertTrue(all(e[1] in ['1','2','3'] for e in events))
+        self.assert_clean_locks()
+
+    def test_generation_database_and_evaluation_failures_propagate(self):
+        for key in ['GENERATE_FAIL','DB_FAIL','EVAL_FAIL']:
+            with self.subTest(key=key):
+                p = self.run_resume(**{key:'1'})
+                self.assertNotEqual(p.returncode,0)
+                self.assertNotIn('RESUME DONE',(self.runs/'resume.log').read_text())
+                self.assert_clean_locks()
+        events = [json.loads(s) for s in (self.root/'db.log').read_text().splitlines()]
+        self.assertEqual([e[0] for e in events],['up','up','down'])
+
+    def test_successful_evaluator_cannot_hide_missing_results(self):
+        self.assertNotEqual(self.run_resume(EVAL_SKIP='1').returncode,0)
+        self.assertNotIn('RESUME DONE',(self.runs/'resume.log').read_text())
+        self.assert_clean_locks()
+
+    def test_slot_claim_does_not_delete_someone_elses_claim(self):
+        (self.runs/'slot-1').mkdir()
+        self.assertNotEqual(self.run_resume().returncode,0)
+        self.assertTrue((self.runs/'slot-1').exists())
+        self.assertFalse((self.runs/self.name/'generate-count').exists())
+
+    def test_archive_move_failure_keeps_source_and_cleans_only_own_reservation(self):
