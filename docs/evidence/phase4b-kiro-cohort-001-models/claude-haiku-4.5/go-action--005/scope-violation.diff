diff --git a/internal/action/action.go b/internal/action/action.go
index 0019441..afac8bc 100644
--- a/internal/action/action.go
+++ b/internal/action/action.go
@@ -28,6 +28,9 @@ type Transition struct {
 // Approve is the existing batch approval Action.
 var Approve = Transition{Operation: "bulk-approve.v3", From: "submitted", To: "approved", Field: "approvedIds"}
 
+// Reject is the batch rejection Action.
+var Reject = Transition{Operation: "bulk-reject.v4", From: "submitted", To: "rejected", Field: "rejectedIds"}
+
 type Rejection struct{ Status int }
 
 func (r *Rejection) Error() string { return fmt.Sprintf("action rejected: %d", r.Status) }
diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index 0fd94e3..233c044 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -28,5 +28,19 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 		}
 		return protocol.Result{Field: action.Approve.Field, IDs: approved}, replayed, nil
 	}
-	return protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": approve}, fallback), nil
+	reject := func(ctx context.Context, u app.Identity, key string, ids []string) (protocol.Result, bool, error) {
+		rejected, replayed, err := executor.Run(ctx, u, action.Reject, key, ids)
+		var denied *action.Rejection
+		if errors.As(err, &denied) {
+			return protocol.Result{}, false, &protocol.Rejection{Status: denied.Status}
+		}
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		return protocol.Result{Field: action.Reject.Field, IDs: rejected}, replayed, nil
+	}
+	return protocol.HTTP(protocol.Routes{
+		"/purchases/bulk-approve": approve,
+		"/purchases/bulk-reject":  reject,
+	}, fallback), nil
 }
