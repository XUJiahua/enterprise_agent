diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index 0fd94e3..4eee806 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -1,10 +1,11 @@
-// Existing batch approval through the platform Action kernel.
+// Batch approval and rejection through the platform Action kernel.
 package candidate
 
 import (
 	"context"
 	"errors"
 	"net/http"
+	"sort"
 
 	"github.com/XUJiahua/enterprise_agent/internal/action"
 	"github.com/XUJiahua/enterprise_agent/internal/app"
@@ -12,6 +13,9 @@ import (
 	"github.com/jackc/pgx/v5/pgxpool"
 )
 
+// Reject is the batch rejection transition.
+var Reject = action.Transition{Operation: "bulk-reject.v4", From: "submitted", To: "rejected", Field: "rejectedIds"}
+
 func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.Handler, error) {
 	executor, err := action.New(ctx, pool)
 	if err != nil {
@@ -28,5 +32,22 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 		}
 		return protocol.Result{Field: action.Approve.Field, IDs: approved}, replayed, nil
 	}
-	return protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": approve}, fallback), nil
+	reject := func(ctx context.Context, u app.Identity, key string, ids []string) (protocol.Result, bool, error) {
+		rejected, replayed, err := executor.Run(ctx, u, Reject, key, ids)
+		var denied *action.Rejection
+		if errors.As(err, &denied) {
+			return protocol.Result{}, false, &protocol.Rejection{Status: denied.Status}
+		}
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		// Sort rejected IDs by UTF-8 dictionary order
+		sorted := append([]string(nil), rejected...)
+		sort.Strings(sorted)
+		return protocol.Result{Field: Reject.Field, IDs: sorted}, replayed, nil
+	}
+	return protocol.HTTP(protocol.Routes{
+		"/purchases/bulk-approve": approve,
+		"/purchases/bulk-reject":  reject,
+	}, fallback), nil
 }
