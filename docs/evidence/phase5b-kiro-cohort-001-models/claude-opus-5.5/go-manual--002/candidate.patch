diff --git a/internal/candidate/reopen.go b/internal/candidate/reopen.go
new file mode 100644
index 0000000..e3f40f6
--- /dev/null
+++ b/internal/candidate/reopen.go
@@ -0,0 +1,84 @@
+package candidate
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReopen = "reopen.v5"
+
+// newReopen moves one rejected purchase of the calling requester back to
+// submitted. protocol.Item has already authenticated a requester and
+// validated the key, the path ID and the reason.
+func newReopen(pool *pgxpool.Pool) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		lock, _ := json.Marshal([]string{opReopen, u.Tenant, u.User, key})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// The digest covers the target only, so ledger.Verify can recompute it
+		// from the stored {"id":...} response.
+		hash := ledger.Fingerprint(opReopen, []string{id})
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+			u.Tenant, u.User, opReopen, key).Scan(&savedHash, &saved)
+		switch {
+		case err == nil && savedHash != hash:
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		case err == nil:
+			var body protocol.ItemResult
+			if err = json.Unmarshal(saved, &body); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return body, true, tx.Commit(ctx)
+		case !errors.Is(err, pgx.ErrNoRows):
+			return protocol.ItemResult{}, false, err
+		}
+		// The row lock taken by UPDATE serialises competing reopens of the same
+		// purchase; the loser re-evaluates status='rejected' and changes nothing.
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='submitted' WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3 AND status='rejected'`, id, u.Tenant, u.User)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// Ineligible targets (missing, other tenant, wrong owner or state) all get the same
+		// 409; unlike the legacy per-purchase handlers in internal/app, Actions never reveal existence.
+		if tag.RowsAffected() != 1 {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		result := protocol.ItemResult{ID: id, Status: "submitted"}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		batch := &pgx.Batch{}
+		batch.Queue(`INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus",reason) VALUES ($1,$2,$3,$4,$5,'rejected','submitted',$6)`,
+			u.Tenant, id, u.User, opReopen, key, reason)
+		batch.Queue(`INSERT INTO "PurchaseEvent" ("tenantId","purchaseId",type,"actorId","idempotencyKey") VALUES ($1,$2,'purchase.reopened',$3,$4)`,
+			u.Tenant, id, u.User, key)
+		batch.Queue(`INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response) VALUES ($1,$2,$3,$4,$5,$6::jsonb)`,
+			u.Tenant, u.User, opReopen, key, hash, string(response))
+		if err = tx.SendBatch(ctx, batch).Close(); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		return result, false, nil
+	}
+}
diff --git a/internal/candidate/reopen_test.go b/internal/candidate/reopen_test.go
new file mode 100644
index 0000000..15005a5
--- /dev/null
+++ b/internal/candidate/reopen_test.go
@@ -0,0 +1,47 @@
+package candidate
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// These cases are rejected by the shared adapter before any database access.
+func TestReopenAdapterRejectsWithoutDatabase(t *testing.T) {
+	fallback := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(418) })
+	h, err := New(context.Background(), nil, fallback)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, method, path, auth, key, body string
+		want                                int
+	}{
+		{"unauthenticated", "POST", "/purchases/p1/reopen", "", "k1", `{"reason":"x"}`, 401},
+		{"approver", "POST", "/purchases/p1/reopen", "Bearer demo_bob", "k1", `{"reason":"x"}`, 403},
+		{"missing reason", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "k1", `{}`, 400},
+		{"long reason", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "k1", `{"reason":"` + strings.Repeat("a", 201) + `"}`, 400},
+		{"missing key", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "", `{"reason":"x"}`, 400},
+		{"bulk reject requester", "POST", "/purchases/bulk-reject", "Bearer demo_alice", "k1", `{"ids":["p1"]}`, 403},
+		{"other path falls back", "GET", "/purchases/p1", "Bearer demo_alice", "", "", 418},
+		{"get reopen falls back", "GET", "/purchases/p1/reopen", "Bearer demo_alice", "", "", 418},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			r := httptest.NewRequest(c.method, c.path, strings.NewReader(c.body))
+			if c.auth != "" {
+				r.Header.Set("Authorization", c.auth)
+			}
+			if c.key != "" {
+				r.Header.Set("Idempotency-Key", c.key)
+			}
+			w := httptest.NewRecorder()
+			h.ServeHTTP(w, r)
+			if w.Code != c.want {
+				t.Fatalf("status %d, want %d", w.Code, c.want)
+			}
+		})
+	}
+}
