+++ b/internal/candidate/reopen_test.go
@@ -0,0 +1,45 @@
+package candidate
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+// TestReopenRouting checks the HTTP wiring without a database: the adapter
+// rejects before the kernel is reached, and other paths fall through.
+func TestReopenRouting(t *testing.T) {
+	fallback := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(299) })
+	batches := protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(nil, approveOp), "/purchases/bulk-reject": batch(nil, rejectOp)}, fallback)
+	h := protocol.Item("reopen", "requester", item(nil, reopenOp), batches)
+	cases := []struct {
+		method, path, auth, body string
+		want                     int
+	}{
+		{"POST", "/purchases/p1/reopen", "", `{"reason":"fixed"}`, 401},
+		{"POST", "/purchases/p1/reopen", "Bearer demo_bob", `{"reason":"fixed"}`, 403},
+		{"POST", "/purchases/p1/reopen", "Bearer demo_alice", `{"reason":""}`, 400},
+		{"POST", "/purchases/p1/reopen", "Bearer demo_alice", `{}`, 400},
+		{"POST", "/purchases/bulk-approve", "", `{"ids":["p1"]}`, 401},
+		{"GET", "/purchases/p1/reopen", "Bearer demo_alice", ``, 299},
+		{"GET", "/purchases", "Bearer demo_alice", ``, 299},
+	}
+	for _, c := range cases {
+		r := httptest.NewRequest(c.method, c.path, strings.NewReader(c.body))
+		r.Header.Set("Idempotency-Key", "k1")
+		if c.auth != "" {
+			r.Header.Set("Authorization", c.auth)
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code != c.want {
+			t.Errorf("%s %s auth=%q: got %d want %d", c.method, c.path, c.auth, w.Code, c.want)
+		}
+	}
+	if reopenOp.Name != "reopen.v5" || reopenOp.Role != "requester" || !reopenOp.Own || reopenOp.From != "rejected" || reopenOp.To != "submitted" || reopenOp.Field != "" {
+		t.Fatalf("unexpected reopen operation: %+v", reopenOp)
+	}
+}
