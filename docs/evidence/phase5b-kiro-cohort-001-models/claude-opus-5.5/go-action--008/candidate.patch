@@ -0,0 +1,43 @@
+package candidate
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+// TestReopenRouting covers the checks that happen before the Action kernel
+// runs, so no database is needed.
+func TestReopenRouting(t *testing.T) {
+	fallback := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(299) })
+	h := protocol.Item("reopen", reopenOp.Role, item(nil, reopenOp), fallback)
+	cases := []struct {
+		name, method, path, auth string
+		want                     int
+	}{
+		{"unauthenticated", "POST", "/purchases/p1/reopen", "", 401},
+		{"approver", "POST", "/purchases/p1/reopen", "Bearer demo_bob", 403},
+		{"other verb", "POST", "/purchases/p1/approve", "Bearer demo_alice", 299},
+		{"bulk path", "POST", "/purchases/bulk-approve", "Bearer demo_bob", 299},
+		{"get", "GET", "/purchases/p1/reopen", "Bearer demo_alice", 299},
+	}
+	for _, c := range cases {
+		r := httptest.NewRequest(c.method, c.path, strings.NewReader(`{"reason":"fixed"}`))
+		r.Header.Set("Idempotency-Key", "k1")
+		if c.auth != "" {
+			r.Header.Set("Authorization", c.auth)
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code != c.want {
+			t.Errorf("%s: got %d, want %d", c.name, w.Code, c.want)
+		}
+	}
+	if reopenOp.Name != "reopen.v5" || reopenOp.Role != "requester" || !reopenOp.Own ||
+		reopenOp.From != "rejected" || reopenOp.To != "submitted" || reopenOp.Field != "" {
+		t.Fatalf("unexpected reopen operation: %+v", reopenOp)
+	}
+}
