@@ -0,0 +1,151 @@
+package candidate
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReopen = "reopen.v5"
+
+// newReopen creates an ItemHandler for reopening rejected purchases.
+func newReopen(pool *pgxpool.Pool) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		if strings.ContainsRune(id, 0) {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 404}
+		}
+
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// First, check for idempotent replay without lock (optimistic path)
+		hash := FingerprintReopen(id, reason)
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest"
+		 WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`, u.Tenant, u.User, opReopen, key).Scan(&savedHash, &saved)
+
+		switch {
+		case err == nil && savedHash != hash:
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		case err == nil:
+			// Idempotent replay: return the saved result
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return protocol.ItemResult{ID: id, Status: "submitted"}, true, nil
+		case !errors.Is(err, pgx.ErrNoRows):
+			return protocol.ItemResult{}, false, err
+		}
+
+		// For new requests, acquire lock on the purchase ID to handle concurrent requests
+		// with different keys for the same purchase
+		lock := generatePurchaseLockKey(opReopen, u.Tenant, id)
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, lock); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Re-check ActionRequest after acquiring lock (race condition protection)
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest"
+		 WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`, u.Tenant, u.User, opReopen, key).Scan(&savedHash, &saved)
+
+		switch {
+		case err == nil && savedHash != hash:
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		case err == nil:
+			// Idempotent replay: return the saved result
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return protocol.ItemResult{ID: id, Status: "submitted"}, true, nil
+		case !errors.Is(err, pgx.ErrNoRows):
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Check purchase exists, belongs to current tenant, created by current user, and is rejected
+		var currentStatus string
+		err = tx.QueryRow(ctx, `SELECT status FROM "Purchase" WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3`,
+			id, u.Tenant, u.User).Scan(&currentStatus)
+		if err == pgx.ErrNoRows {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 404}
+		}
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if currentStatus != "rejected" {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+
+		// Update purchase status to submitted
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='submitted' WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3 AND status='rejected'`,
+			id, u.Tenant, u.User)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if tag.RowsAffected() != 1 {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+
+		// Insert audit record
+		_, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus",reason)
+		 VALUES ($1,$2,$3,$4,$5,'rejected','submitted',$6)`, u.Tenant, id, u.User, opReopen, key, reason)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Insert event record
+		_, err = tx.Exec(ctx, `INSERT INTO "PurchaseEvent" ("tenantId","purchaseId",type,"actorId","idempotencyKey") VALUES ($1,$2,'purchase.reopened',$3,$4)`,
+			u.Tenant, id, u.User, key)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Insert ActionRequest for idempotency
+		result := protocol.ItemResult{ID: id, Status: "submitted"}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		_, err = tx.Exec(ctx, `INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response)
+		 VALUES ($1,$2,$3,$4,$5,$6::jsonb)`, u.Tenant, u.User, opReopen, key, hash, string(response))
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		return result, false, nil
+	}
+}
+
+// generatePurchaseLockKey generates a lock key based on operation, tenantId, and purchase ID.
+func generatePurchaseLockKey(verb, tenant, id string) string {
+	return strings.Join([]string{verb, tenant, id}, "\x00")
+}
+
+// FingerprintReopen calculates the hash for a reopen request.
+func FingerprintReopen(id, reason string) string {
+	h := sha256.New()
+	fmt.Fprint(h, opReopen+"\n")
+	fmt.Fprintf(h, "%d:%s", len(id), id)
+	fmt.Fprintf(h, "%d:%s", len(reason), reason)
+	return hex.EncodeToString(h.Sum(nil))
+}
