+	routes := protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}
+	itemRoutes := []protocol.ItemRoute{
+		{Verb: "reopen", Role: "requester", Handler: item(executor, reopenOp)},
+	}
+	return protocol.HTTPWithItem(routes, itemRoutes, fallback), nil
 }
