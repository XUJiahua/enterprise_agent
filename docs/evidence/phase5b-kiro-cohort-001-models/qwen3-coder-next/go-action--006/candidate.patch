diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index ae214e3..88f1307 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -5,6 +5,7 @@ import (
 	"context"
 	"errors"
 	"net/http"
+	"strings"
 
 	"github.com/XUJiahua/enterprise_agent/internal/action"
 	"github.com/XUJiahua/enterprise_agent/internal/app"
@@ -31,10 +32,32 @@ func batch(executor *action.Executor, op action.Operation) protocol.Handler {
 	}
 }
 
+func item(executor *action.Executor, op action.Operation) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		done, replayed, err := executor.Run(ctx, u, op, key, []string{id}, reason)
+		if err != nil {
+			return protocol.ItemResult{}, false, adapt(err)
+		}
+		return protocol.ItemResult{ID: done[0], Status: op.To}, replayed, nil
+	}
+}
+
 func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.Handler, error) {
 	executor, err := action.New(ctx, pool)
 	if err != nil {
 		return nil, err
 	}
-	return protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback), nil
+	bulkHTTP := protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback)
+	reopenHandler := protocol.Item("reopen", "requester", item(executor, reopenOp), fallback)
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/purchases/bulk-approve" || r.URL.Path == "/purchases/bulk-reject" {
+			bulkHTTP.ServeHTTP(w, r)
+			return
+		}
+		if strings.HasPrefix(r.URL.Path, "/purchases/") && strings.HasSuffix(r.URL.Path, "/reopen") {
+			reopenHandler.ServeHTTP(w, r)
+			return
+		}
+		fallback.ServeHTTP(w, r)
+	}), nil
 }
