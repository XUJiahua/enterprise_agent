+// HTTPWithItem extends HTTP to also handle single-target Item routes.
+// Batch routes require approver; Item routes are dispatched by path and role.
+func HTTPWithItem(routes Routes, itemRoutes map[string]ItemHandler, fallback http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Check batch routes first
+		if handle, found := routes[r.URL.Path]; r.Method == http.MethodPost && found {
+			u, ok := app.AuthenticateDemo(r.Header.Get("Authorization"))
+			if !ok {
+				reject(w, 401)
+				return
+			}
+			if u.Role != "approver" {
+				reject(w, 403)
+				return
+			}
+			body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, MaxBodyBytes))
+			if err != nil {
+				var large *http.MaxBytesError
+				if errors.As(err, &large) {
+					reject(w, 413)
+				} else {
+					reject(w, 400)
+				}
+				return
+			}
+			ids, ok := decode(body)
+			keys := r.Header.Values("Idempotency-Key")
+			if !ok || len(keys) != 1 || !validKey(keys[0]) {
+				reject(w, 400)
+				return
+			}
+			ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+			defer cancel()
+			result, replayed, err := handle(ctx, u, keys[0], ids)
+			respond(w, result, replayed, err)
+			return
+		}
+		// Check item routes
+		if handle, found := itemRoutes[r.URL.Path]; r.Method == http.MethodPost && found {
+			Item("reopen", "requester", handle, fallback).ServeHTTP(w, r)
+			return
+		}
+		fallback.ServeHTTP(w, r)
+	})
+}
