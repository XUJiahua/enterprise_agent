--- /dev/null
+++ b/internal/candidate/reopen.go
@@ -0,0 +1,115 @@
+package candidate
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReopen = "reopen.v5"
+
+func newReopen(pool *pgxpool.Pool) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// Advisory lock: (operation, tenant, user, key)
+		lock, _ := json.Marshal([]string{opReopen, u.Tenant, u.User, key})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// Check for existing idempotent request with this (tenant, actor, operation, key)
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+			u.Tenant, u.User, opReopen, key).Scan(&savedHash, &saved)
+		switch {
+		case err == nil:
+			// Found existing request. Verify it's for the same purchase and reason.
+			var body protocol.ItemResult
+			if err = json.Unmarshal(saved, &body); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			if body.ID != id {
+				// Different purchase ID with same key from same actor
+				return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+			}
+			// Same purchase, same actor, same key: verify hash and return replayed
+			expectedHash := ledger.Fingerprint(opReopen+"|"+reason, []string{id})
+			if savedHash != expectedHash {
+				// Same key, different reason
+				return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+			}
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return body, true, nil
+		case !errors.Is(err, pgx.ErrNoRows):
+			// Query error
+			return protocol.ItemResult{}, false, err
+		}
+		// No existing request: check eligibility and process
+		// Must be own purchase, status=rejected, tenant match
+		var status string
+		var createdBy string
+		err = tx.QueryRow(ctx, `SELECT status,"createdBy" FROM "Purchase" WHERE id=$1 AND "tenantId"=$2`,
+			id, u.Tenant).Scan(&status, &createdBy)
+		if err != nil {
+			if errors.Is(err, pgx.ErrNoRows) {
+				// Not found or wrong tenant
+				return protocol.ItemResult{}, false, &protocol.Rejection{Status: 400}
+			}
+			return protocol.ItemResult{}, false, err
+		}
+		// Verify: created by requester, status is rejected
+		if createdBy != u.User || status != "rejected" {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 400}
+		}
+		// Update status to submitted
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='submitted' WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3 AND status='rejected'`,
+			id, u.Tenant, u.User)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if tag.RowsAffected() != 1 {
+			// Race condition or changed state
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 400}
+		}
+		// Record audit
+		_, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus",reason) VALUES ($1,$2,$3,$4,$5,'rejected','submitted',$6)`,
+			u.Tenant, id, u.User, opReopen, key, reason)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// Compute response and hash
+		result := protocol.ItemResult{ID: id, Status: "submitted"}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// Hash for single-item action: use id with reason as part of the operation domain
+		// This distinguishes the same purchase with different reasons
+		hash := ledger.Fingerprint(opReopen+"|"+reason, []string{id})
+		// Record action request
+		_, err = tx.Exec(ctx, `INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response) VALUES ($1,$2,$3,$4,$5,$6::jsonb)`,
+			u.Tenant, u.User, opReopen, key, hash, string(response))
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		return result, false, nil
+	}
+}
