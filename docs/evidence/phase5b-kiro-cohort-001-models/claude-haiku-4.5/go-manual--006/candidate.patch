index 0000000..fbf45c4
--- /dev/null
+++ b/internal/candidate/reopen.go
@@ -0,0 +1,140 @@
+package candidate
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReopen = "reopen.v5"
+
+func newReopen(pool *pgxpool.Pool) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		// Acquire an advisory lock for idempotency
+		lockKey := []string{opReopen, u.Tenant, u.User, key, id}
+		lockKeyJSON, _ := json.Marshal(lockKey)
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lockKeyJSON)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Compute the fingerprint: operation + id + reason
+		fingerprint := computeFingerprint(id, reason)
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest" 
+		 WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+			u.Tenant, u.User, opReopen, key).Scan(&savedHash, &saved)
+		switch {
+		case err == nil && savedHash != fingerprint:
+			// Different request hash with same key = 409 conflict
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		case err == nil:
+			// Replayed request - extract and return the stored response
+			var body protocol.ItemResult
+			if err = json.Unmarshal(saved, &body); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return body, true, nil
+		case !errors.Is(err, pgx.ErrNoRows):
+			// Database error
+			return protocol.ItemResult{}, false, err
+		}
+
+		// New request: verify the purchase exists, belongs to the requester, and is in rejected state
+		var status string
+		err = tx.QueryRow(ctx, `SELECT status FROM "Purchase" 
+		 WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3 
+		 FOR UPDATE`, id, u.Tenant, u.User).Scan(&status)
+		if err == pgx.ErrNoRows {
+			// Purchase does not exist or doesn't belong to this requester
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 400}
+		}
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if status != "rejected" {
+			// Purchase is not in rejected state
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 400}
+		}
+
+		// Update the purchase status to 'submitted'
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='submitted' 
+		 WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3 AND status='rejected'`,
+			id, u.Tenant, u.User)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if tag.RowsAffected() != 1 {
+			// Concurrent modification or ineligible state
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+
+		// Insert audit record with reason
+		_, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit" 
+		 ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus",reason)
+		 VALUES ($1,$2,$3,$4,$5,'rejected','submitted',$6)`,
+			u.Tenant, id, u.User, opReopen, key, reason)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Insert purchase event
+		_, err = tx.Exec(ctx, `INSERT INTO "PurchaseEvent" 
+		 ("tenantId","purchaseId",type,"actorId","idempotencyKey")
+		 VALUES ($1,$2,'purchase.reopened',$3,$4)`,
+			u.Tenant, id, u.User, key)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Create the response
+		result := protocol.ItemResult{ID: id, Status: "submitted"}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		// Insert the action request record
+		_, err = tx.Exec(ctx, `INSERT INTO "ActionRequest" 
+		 ("tenantId","actorId",operation,key,"requestHash",response)
+		 VALUES ($1,$2,$3,$4,$5,$6::jsonb)`,
+			u.Tenant, u.User, opReopen, key, fingerprint, string(response))
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		return result, false, nil
+	}
+}
+
+// computeFingerprint creates a deterministic hash of the operation inputs
+func computeFingerprint(id, reason string) string {
+	h := sha256.New()
+	fmt.Fprint(h, opReopen, "\n")
+	fmt.Fprintf(h, "%d:%s", len(id), id)
+	fmt.Fprintf(h, "%d:%s", len(reason), reason)
+	return hex.EncodeToString(h.Sum(nil))
+}
