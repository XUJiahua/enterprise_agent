 CREATE TRIGGER purchase_tier_guard BEFORE UPDATE OF status ON "Purchase" FOR EACH ROW EXECUTE FUNCTION purchase_tier_guard();
+
+-- v6b additive disposable POC schema, applied after the v6a schema.
+-- The countersign operation for second-level approval.
+ALTER TABLE "ActionRequest" DROP CONSTRAINT "ActionRequest_operation_check";
+ALTER TABLE "ActionRequest" ADD CONSTRAINT "ActionRequest_operation_check" CHECK (operation IN ('bulk-approve.v3','bulk-reject.v4','reopen.v5','countersign.v6'));
+ALTER TABLE "ApprovalAudit" DROP CONSTRAINT "ApprovalAudit_operation_check";
+ALTER TABLE "ApprovalAudit" ADD CONSTRAINT "ApprovalAudit_operation_check" CHECK (operation IN ('bulk-approve.v3','bulk-reject.v4','reopen.v5','countersign.v6'));
diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index 05a1474..46184ca 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -43,5 +43,12 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 		}
 		return protocol.ItemResult{ID: done[0], Status: reopenOp.To}, replayed, nil
 	}
-	return protocol.Item("reopen", "requester", reopen, protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback)), nil
+	countersign := func(ctx context.Context, u app.Identity, key, id string, amount int) (protocol.ItemResult, bool, error) {
+		done, replayed, err := executor.Run(ctx, u, countersignOp, key, action.Request{IDs: []string{id}, Amount: amount})
+		if err != nil {
+			return protocol.ItemResult{}, false, adapt(err)
+		}
+		return protocol.ItemResult{ID: done[0], Status: countersignOp.To}, replayed, nil
+	}
+	return protocol.Confirm("countersign", "approver", countersign, protocol.Item("reopen", "requester", reopen, protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback))), nil
 }
