diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index 9702a45..a3a4f50 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -16,6 +16,7 @@ import (
 )
 
 const opApprove = "bulk-approve.v3"
+const opCountersign = "countersign.v6"
 
 // Purchases above secondApprovalOver need two different approvers: bulk-approve
 // only moves them to pending-second, and they stay listed in approvedIds.
@@ -127,5 +128,106 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 		}
 		return result, false, nil
 	}
-	return protocol.Item("reopen", "requester", newReopen(pool), protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": approve, "/purchases/bulk-reject": newReject(pool)}, fallback)), nil
+	countersign := newCountersign(pool)
+	return protocol.Confirm("countersign", "approver", countersign,
+		protocol.Item("reopen", "requester", newReopen(pool),
+			protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": approve, "/purchases/bulk-reject": newReject(pool)}, fallback))), nil
+}
+
+func newCountersign(pool *pgxpool.Pool) protocol.ConfirmHandler {
+	return func(ctx context.Context, u app.Identity, key, id string, amount int) (protocol.ItemResult, bool, error) {
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		lock, _ := json.Marshal([]string{opCountersign, u.Tenant, u.User, key, id})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		hash := ledger.Fingerprint(opCountersign, []string{id})
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+			u.Tenant, u.User, opCountersign, key).Scan(&savedHash, &saved)
+		if err == nil {
+			if savedHash != hash {
+				return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+			}
+			var stored protocol.ItemResult
+			if err = json.Unmarshal(saved, &stored); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return stored, true, tx.Commit(ctx)
+		}
+		if !errors.Is(err, pgx.ErrNoRows) {
+			return protocol.ItemResult{}, false, err
+		}
+		var creator, currentAmount int
+		var status string
+		err = tx.QueryRow(ctx, `SELECT "createdBy",amount,status FROM "Purchase" WHERE id=$1 AND "tenantId"=$2 FOR UPDATE`, id, u.Tenant).Scan(&creator, &currentAmount, &status)
+		if errors.Is(err, pgx.ErrNoRows) {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if status != "pending-second" {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		if creator == u.User {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		if currentAmount != amount {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		firstApprover, err := tx.QueryRow(ctx, `SELECT "approvedBy" FROM "ApprovalAudit" a
+		 WHERE a."tenantId"=$1 AND a."purchaseId"=$2 AND a."toStatus"='pending-second'
+		 ORDER BY a."createdAt" DESC LIMIT 1`, u.Tenant, id).Scan(nil)
+		if err == nil {
+			var firstApprover string
+			err = tx.QueryRow(ctx, `SELECT "approvedBy" FROM "ApprovalAudit" a
+			 WHERE a."tenantId"=$1 AND a."purchaseId"=$2 AND a."toStatus"='pending-second'
+			 ORDER BY a."createdAt" DESC LIMIT 1`, u.Tenant, id).Scan(&firstApprover)
+			if err != nil && !errors.Is(err, pgx.ErrNoRows) {
+				return protocol.ItemResult{}, false, err
+			}
+			if err == nil && firstApprover == u.User {
+				return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+			}
+		} else if !errors.Is(err, pgx.ErrNoRows) {
+			return protocol.ItemResult{}, false, err
+		}
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='approved' WHERE id=$1 AND "tenantId"=$2 AND status='pending-second'`, id, u.Tenant)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if tag.RowsAffected() != 1 {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		if _, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus") VALUES ($1,$2,$3,$4,$5,'pending-second','approved')`,
+			u.Tenant, id, u.User, opCountersign, key); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if _, err = tx.Exec(ctx, `INSERT INTO "PurchaseEvent" ("tenantId","purchaseId",type,"actorId","idempotencyKey") VALUES ($1,$2,'purchase.countersigned',$3,$4)`,
+			u.Tenant, id, u.User, key); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		result := protocol.ItemResult{ID: id, Status: "approved"}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if _, err = tx.Exec(ctx, `INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response) VALUES ($1,$2,$3,$4,$5,$6::jsonb)`,
+			u.Tenant, u.User, opCountersign, key, hash, string(response)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		return result, false, nil
+	}
 }
