@@ -10,4 +10,8 @@ var (
 		From: "submitted", To: "rejected", Field: "rejectedIds", Event: "purchase.rejected"}
 	reopenOp = action.Operation{Name: "reopen.v5", Role: "requester", Own: true,
 		From: "rejected", To: "submitted", Event: "purchase.reopened"}
+	// countersignOp is the second approval of a tiered purchase: a different
+	// approver than the one who moved it to pending-second confirms the amount.
+	countersignOp = action.Operation{Name: "countersign.v6", Role: "approver", Own: false,
+		From: "pending-second", To: "approved", Separate: true, Confirm: true, Event: action.NoEvent}
 )
