diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index 05a1474..82fa0ce 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -43,5 +43,13 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 		}
 		return protocol.ItemResult{ID: done[0], Status: reopenOp.To}, replayed, nil
 	}
-	return protocol.Item("reopen", "requester", reopen, protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback)), nil
+	countersign := func(ctx context.Context, u app.Identity, key, id string, amount int) (protocol.ItemResult, bool, error) {
+		done, replayed, err := executor.Run(ctx, u, countersignOp, key, action.Request{IDs: []string{id}, Amount: amount})
+		if err != nil {
+			return protocol.ItemResult{}, false, adapt(err)
+		}
+		return protocol.ItemResult{ID: done[0], Status: countersignOp.To}, replayed, nil
+	}
+	routes := protocol.Item("reopen", "requester", reopen, protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback))
+	return protocol.Confirm("countersign", "approver", countersign, routes), nil
 }
diff --git a/internal/candidate/operations.go b/internal/candidate/operations.go
index f9c0953..f3fa0b3 100644
