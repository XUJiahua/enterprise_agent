diff --git a/internal/candidate/approval.go b/internal/candidate/approval.go
index ae214e3..29b3ab9 100644
--- a/internal/candidate/approval.go
+++ b/internal/candidate/approval.go
@@ -31,10 +31,25 @@ func batch(executor *action.Executor, op action.Operation) protocol.Handler {
 	}
 }
 
+func reopen(executor *action.Executor, op action.Operation) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		done, replayed, err := executor.Run(ctx, u, op, key, []string{id}, reason)
+		if err != nil {
+			return protocol.ItemResult{}, false, adapt(err)
+		}
+		return protocol.ItemResult{ID: done[0], Status: op.To}, replayed, nil
+	}
+}
+
 func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.Handler, error) {
 	executor, err := action.New(ctx, pool)
 	if err != nil {
 		return nil, err
 	}
-	return protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback), nil
+	handler := protocol.HTTP(protocol.Routes{
+		"/purchases/bulk-approve": batch(executor, approveOp),
+		"/purchases/bulk-reject":  batch(executor, rejectOp),
+	}, fallback)
+	handler = protocol.Item("reopen", "requester", reopen(executor, reopenOp), handler)
+	return handler, nil
 }
