@@ -0,0 +1,50 @@
+package candidate
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+// The rejection paths below never reach the kernel, so no database is needed.
+func TestReopenAdapterRejectsBeforeKernel(t *testing.T) {
+	fallback := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(418) })
+	h := protocol.Item("reopen", reopenOp.Role, item(nil, reopenOp), fallback)
+	cases := []struct {
+		name, method, path, auth, key, body string
+		want                                int
+	}{
+		{"unauthenticated", "POST", "/purchases/p1/reopen", "", "k1", `{"reason":"fixed"}`, 401},
+		{"approver", "POST", "/purchases/p1/reopen", "Bearer demo_bob", "k1", `{"reason":"fixed"}`, 403},
+		{"missing reason", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "k1", `{}`, 400},
+		{"empty reason", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "k1", `{"reason":""}`, 400},
+		{"long reason", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "k1", `{"reason":"` + strings.Repeat("x", 201) + `"}`, 400},
+		{"missing key", "POST", "/purchases/p1/reopen", "Bearer demo_alice", "", `{"reason":"fixed"}`, 400},
+		{"other path", "POST", "/purchases/p1/approve", "Bearer demo_alice", "k1", `{"reason":"fixed"}`, 418},
+		{"get", "GET", "/purchases/p1/reopen", "Bearer demo_alice", "k1", ``, 418},
+	}
+	for _, c := range cases {
+		r := httptest.NewRequest(c.method, c.path, strings.NewReader(c.body))
+		if c.auth != "" {
+			r.Header.Set("Authorization", c.auth)
+		}
+		if c.key != "" {
+			r.Header.Set("Idempotency-Key", c.key)
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code != c.want {
+			t.Errorf("%s: status %d, want %d", c.name, w.Code, c.want)
+		}
+	}
+}
+
+func TestReopenOperation(t *testing.T) {
+	if reopenOp.Name != "reopen.v5" || reopenOp.Role != "requester" || !reopenOp.Own ||
+		reopenOp.From != "rejected" || reopenOp.To != "submitted" || reopenOp.Field != "" || reopenOp.Event == "" {
+		t.Fatalf("unexpected reopen operation: %+v", reopenOp)
+	}
+}
