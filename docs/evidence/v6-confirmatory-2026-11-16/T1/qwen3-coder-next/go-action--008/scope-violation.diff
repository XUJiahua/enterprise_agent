 		return nil, err
 	}
-	return protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback), nil
+	reopen := item(executor, reopenOp)
+	routes := protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}
+	itemRoutes := protocol.ItemRoutes{"/purchases/{id}/reopen": reopen}
+	return protocol.Compose(routes, itemRoutes, fallback), nil
 }
