+func reassign(executor *action.Executor, op action.Update) protocol.AssignHandler {
+	return func(ctx context.Context, u app.Identity, key string, ids []string, assignee string) (protocol.AssignResult, bool, error) {
+		done, replayed, err := executor.Set(ctx, u, op, key, ids, assignee)
+		if err != nil {
+			return protocol.AssignResult{}, false, adapt(err)
+		}
+		return protocol.AssignResult{Field: op.Field, IDs: done, Assignee: assignee}, replayed, nil
+	}
+}
