 // Fingerprint is the request digest shared by every Action operation: the
 // operation name is the domain separator, IDs are length-prefixed and sorted.
-func Fingerprint(operation string, ids []string) string {
-	sorted := append([]string(nil), ids...)
-	sort.Strings(sorted)
+// For operations with an additional parameter (e.g., assignee), include it after IDs.
+func Fingerprint(operation string, params ...any) string {
 	h := sha256.New()
 	fmt.Fprint(h, operation, "\n")
-	for _, id := range sorted {
-		fmt.Fprintf(h, "%d:%s", len(id), id)
+	for _, p := range params {
+		switch v := p.(type) {
+		case string:
+			fmt.Fprintf(h, "%d:%s", len(v), v)
+		case []string:
+			sorted := append([]string(nil), v...)
+			sort.Strings(sorted)
+			for _, s := range sorted {
+				fmt.Fprintf(h, "%d:%s", len(s), s)
+			}
+		}
 	}
 	return hex.EncodeToString(h.Sum(nil))
 }
