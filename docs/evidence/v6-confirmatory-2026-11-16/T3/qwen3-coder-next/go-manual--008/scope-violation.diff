+// FingerprintAssignee is the fingerprint for assignee-parameterized operations.
+func FingerprintAssignee(operation string, ids []string, assignee string) string {
+	sorted := append([]string(nil), ids...)
+	sort.Strings(sorted)
+	h := sha256.New()
+	fmt.Fprint(h, operation, "\n")
+	for _, id := range sorted {
+		fmt.Fprintf(h, "%d:%s", len(id), id)
+	}
+	fmt.Fprintf(h, "%d:%s", len(assignee), assignee)
+	return hex.EncodeToString(h.Sum(nil))
+}
