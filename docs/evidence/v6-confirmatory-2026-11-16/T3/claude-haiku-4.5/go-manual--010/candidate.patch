diff --git a/internal/candidate/reassign.go b/internal/candidate/reassign.go
new file mode 100644
index 0000000..f014ddf
--- /dev/null
+++ b/internal/candidate/reassign.go
@@ -0,0 +1,154 @@
+package candidate
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sort"
+	"strings"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReassign = "bulk-reassign.v6"
+
+func newReassign(pool *pgxpool.Pool) protocol.AssignHandler {
+	return func(ctx context.Context, u app.Identity, key string, ids []string, assignee string) (protocol.AssignResult, bool, error) {
+		// Validate IDs for null bytes
+		for _, id := range ids {
+			if strings.ContainsRune(id, 0) {
+				return protocol.AssignResult{}, false, &protocol.Rejection{Status: 400}
+			}
+		}
+		// Validate assignee for null bytes
+		if strings.ContainsRune(assignee, 0) {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 400}
+		}
+
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Create lock based on operation, tenant, user, and key
+		lock, _ := json.Marshal([]string{opReassign, u.Tenant, u.User, key})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Compute request hash with assignee in the digest domain
+		domain := opReassign + "\n" + assignee
+		hash := ledger.Fingerprint(domain, ids)
+
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+			u.Tenant, u.User, opReassign, key).Scan(&savedHash, &saved)
+
+		switch {
+		case err == nil && savedHash != hash:
+			// Same key but different request (IDs or assignee differ)
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 409}
+		case err == nil:
+			// Idempotent replay
+			var body protocol.AssignResult
+			if err = json.Unmarshal(saved, &body); err != nil {
+				return protocol.AssignResult{}, false, err
+			}
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.AssignResult{}, false, err
+			}
+			return body, true, nil
+		case !errors.Is(err, pgx.ErrNoRows):
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Verify assignee exists in TenantMember, is an approver, and is active
+		var assigneeExists bool
+		err = tx.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM "TenantMember" WHERE "tenantId"=$1 AND "userId"=$2 AND role='approver' AND active=true)`,
+			u.Tenant, assignee).Scan(&assigneeExists)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		if !assigneeExists {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 400}
+		}
+
+		// Query all target purchases, locking them for update
+		// Must be: current tenant, not created by caller, status=submitted
+		rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`,
+			ids, u.Tenant, u.User)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		eligible := []string{}
+		for rows.Next() {
+			var id string
+			if err = rows.Scan(&id); err != nil {
+				rows.Close()
+				return protocol.AssignResult{}, false, err
+			}
+			eligible = append(eligible, id)
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// All targets must be eligible; if any is missing, ineligible, or by caller, return 400
+		if len(eligible) != len(ids) {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 400}
+		}
+
+		// Update all purchase assigneeIds
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET "assigneeId"=$1 WHERE id=ANY($2::text[]) AND "tenantId"=$3 AND "createdBy"<>$4 AND status='submitted'`,
+			assignee, ids, u.Tenant, u.User)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		if tag.RowsAffected() != int64(len(ids)) {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 400}
+		}
+
+		// Create assignment history records for each purchase
+		batch := &pgx.Batch{}
+		for _, id := range ids {
+			batch.Queue(`INSERT INTO "AssignmentHistory" ("tenantId","purchaseId","fromAssignee","toAssignee","changedBy",operation,"idempotencyKey") VALUES ($1,$2,NULL,$3,$4,$5,$6)`,
+				u.Tenant, id, assignee, u.User, opReassign, key)
+		}
+
+		// Sort IDs for response (should already be sorted from protocol layer, but ensure it)
+		responseIDs := append([]string(nil), ids...)
+		sort.Strings(responseIDs)
+
+		result := protocol.AssignResult{Field: "reassignedIds", IDs: responseIDs, Assignee: assignee}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		batch.Queue(`INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response) VALUES ($1,$2,$3,$4,$5,$6::jsonb)`,
+			u.Tenant, u.User, opReassign, key, hash, string(response))
+
+		if err = tx.SendBatch(ctx, batch).Close(); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		return result, false, nil
+	}
+}
