index 0000000..b6e6d22
--- /dev/null
+++ b/internal/candidate/reassign.go
@@ -0,0 +1,132 @@
+package candidate
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReassign = "bulk-reassign.v6"
+
+// newReassign serves the approver-side bulk reassignment of purchases.
+func newReassign(pool *pgxpool.Pool) protocol.AssignHandler {
+	return func(ctx context.Context, u app.Identity, key string, ids []string, assignee string) (protocol.AssignResult, bool, error) {
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		lock, _ := json.Marshal([]string{opReassign, u.Tenant, u.User, key})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Build the request hash from operation, assignee, and IDs
+		requestHash := ledger.Fingerprint(opReassign+"\n"+assignee, ids)
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+			u.Tenant, u.User, opReassign, key).Scan(&savedHash, &saved)
+		if err == nil {
+			if savedHash != requestHash {
+				return protocol.AssignResult{}, false, &protocol.Rejection{Status: 409}
+			}
+			var stored protocol.AssignResult
+			if err = json.Unmarshal(saved, &stored); err != nil {
+				return protocol.AssignResult{}, false, err
+			}
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.AssignResult{}, false, err
+			}
+			return stored, true, nil
+		}
+		if !errors.Is(err, pgx.ErrNoRows) {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Verify assignee is a valid approver in the current tenant
+		var assigneeRole string
+		var assigneeActive bool
+		err = tx.QueryRow(ctx, `SELECT role,active FROM "TenantMember" WHERE "tenantId"=$1 AND "userId"=$2`,
+			u.Tenant, assignee).Scan(&assigneeRole, &assigneeActive)
+		if errors.Is(err, pgx.ErrNoRows) || (err == nil && (assigneeRole != "approver" || !assigneeActive)) {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Get all eligible purchases for update (locked rows)
+		rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`, ids, u.Tenant, u.User)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		eligible := []string{}
+		for rows.Next() {
+			var id string
+			if err = rows.Scan(&id); err != nil {
+				rows.Close()
+				return protocol.AssignResult{}, false, err
+			}
+			eligible = append(eligible, id)
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Ineligible targets (missing, other tenant, wrong owner or state) all get the same
+		// 409; unlike the legacy per-purchase handlers in internal/app, Actions never reveal existence.
+		if len(eligible) != len(ids) {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 409}
+		}
+
+		// Update assigneeId for all eligible purchases
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET "assigneeId"=$1 WHERE id=ANY($2::text[]) AND "tenantId"=$3 AND "createdBy"<>$4 AND status='submitted'`, assignee, ids, u.Tenant, u.User)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+		if tag.RowsAffected() != int64(len(ids)) {
+			return protocol.AssignResult{}, false, &protocol.Rejection{Status: 409}
+		}
+
+		// Record assignment history for each purchase
+		batch := &pgx.Batch{}
+		for _, id := range ids {
+			batch.Queue(`INSERT INTO "AssignmentHistory" ("tenantId","purchaseId","fromAssignee","toAssignee","changedBy",operation,"idempotencyKey") 
+			 VALUES ($1,$2,NULL,$3,$4,$5,$6)`,
+				u.Tenant, id, assignee, u.User, opReassign, key)
+		}
+
+		// Build result with sorted IDs
+		result := protocol.AssignResult{Field: "reassignedIds", IDs: ids, Assignee: assignee}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		// Record ActionRequest for idempotency
+		batch.Queue(`INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response) VALUES ($1,$2,$3,$4,$5,$6::jsonb)`,
+			u.Tenant, u.User, opReassign, key, requestHash, string(response))
+
+		if err = tx.SendBatch(ctx, batch).Close(); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.AssignResult{}, false, err
+		}
+
+		return result, false, nil
+	}
+}
