index 0000000..d1a4242
--- /dev/null
+++ b/internal/app/bulk_approve.go
@@ -0,0 +1,119 @@
+package app
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"sort"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Decode the envelope explicitly so field names are exact and repeated fields
+// cannot silently replace an earlier list of IDs.
+func bulkApprovalIDs(body io.Reader) ([]string, error) {
+	b, err := io.ReadAll(body)
+	if err != nil {
+		return nil, err
+	}
+	if !utf8.Valid(b) {
+		return nil, invalidBulkApproval
+	}
+	d := json.NewDecoder(bytes.NewReader(b))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') || !d.More() {
+		return nil, invalidBulkApproval
+	}
+	key, err := d.Token()
+	if err != nil || key != "ids" {
+		return nil, invalidBulkApproval
+	}
+	var ids []string
+	if err := d.Decode(&ids); err != nil || len(ids) < 1 || len(ids) > 100 {
+		return nil, invalidBulkApproval
+	}
+	if d.More() {
+		return nil, invalidBulkApproval
+	}
+	if token, err = d.Token(); err != nil || token != json.Delim('}') {
+		return nil, invalidBulkApproval
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return nil, invalidBulkApproval
+	}
+	seen := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		if id == "" || len(id) > 100 || seen[id] {
+			return nil, invalidBulkApproval
+		}
+		seen[id] = true
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+
+var invalidBulkApproval = errors.New("invalid bulk approval request")
+
+func (s *Server) bulkApprove(r *http.Request, tx pgx.Tx, u Identity) (any, int, error) {
+	ids, err := bulkApprovalIDs(r.Body)
+	if err != nil {
+		return nil, http.StatusBadRequest, nil
+	}
+	if u.Role != "approver" {
+		return nil, http.StatusForbidden, nil
+	}
+	for _, id := range ids {
+		// PostgreSQL text IDs cannot contain NUL, so these targets cannot
+		// exist. Avoid passing them to the database's text encoder.
+		if strings.IndexByte(id, 0) >= 0 {
+			return nil, http.StatusNotFound, nil
+		}
+	}
+
+	// Lock every visible target in a consistent order before checking any of
+	// them. A competing batch sees the committed status after acquiring its
+	// locks; no writes occur until this entire batch has passed validation.
+	rows, err := tx.Query(r.Context(), `SELECT id,"createdBy",status FROM "Purchase"
+		WHERE "tenantId"=$1 AND id=ANY($2::text[]) ORDER BY id FOR UPDATE`, u.Tenant, ids)
+	if err != nil {
+		return nil, 0, err
+	}
+	count, own, conflict := 0, false, false
+	for rows.Next() {
+		var id, creator, status string
+		if err = rows.Scan(&id, &creator, &status); err != nil {
+			rows.Close()
+			return nil, 0, err
+		}
+		count++
+		own = own || creator == u.User
+		conflict = conflict || status != "submitted"
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, 0, err
+	}
+	if count != len(ids) {
+		return nil, http.StatusNotFound, nil
+	}
+	if own {
+		return nil, http.StatusForbidden, nil
+	}
+	if conflict {
+		return nil, http.StatusConflict, nil
+	}
+	result, err := tx.Exec(r.Context(), `UPDATE "Purchase" SET status='approved'
+		WHERE "tenantId"=$1 AND id=ANY($2::text[]) AND "createdBy"<>$3 AND status='submitted'`, u.Tenant, ids, u.User)
+	if err != nil {
+		return nil, 0, err
+	}
+	if result.RowsAffected() != int64(len(ids)) {
+		return nil, http.StatusConflict, nil
+	}
+	return map[string]any{"approvedIds": ids}, http.StatusOK, nil
+}
diff --git a/internal/app/bulk_approve_test.go b/internal/app/bulk_approve_test.go
