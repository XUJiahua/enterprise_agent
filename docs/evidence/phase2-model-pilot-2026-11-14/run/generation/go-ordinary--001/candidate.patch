@@ -0,0 +1,68 @@
+package app
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestBulkApprovalIDs(t *testing.T) {
+	validIDs := make([]string, 100)
+	for i := range validIDs {
+		validIDs[i] = fmt.Sprintf("%03d", i)
+	}
+	maxIDs, _ := json.Marshal(map[string]any{"ids": validIDs})
+	tooMany, _ := json.Marshal(map[string]any{"ids": append(validIDs, "extra")})
+	tests := []struct {
+		name string
+		body string
+		want []string
+	}{
+		{"sorted", `{"ids":["z","a"]}`, []string{"a", "z"}},
+		{"max count", string(maxIDs), validIDs},
+		{"max bytes", `{"ids":["` + strings.Repeat("界", 33) + `a"]}`, []string{strings.Repeat("界", 33) + "a"}},
+		{"empty body", "", nil},
+		{"null object", `null`, nil},
+		{"array", `[]`, nil},
+		{"string", `"ids"`, nil},
+		{"missing ids", `{}`, nil},
+		{"empty ids", `{"ids":[]}`, nil},
+		{"null ids", `{"ids":null}`, nil},
+		{"wrong ids type", `{"ids":"a"}`, nil},
+		{"empty id", `{"ids":[""]}`, nil},
+		{"null id", `{"ids":[null]}`, nil},
+		{"numeric id", `{"ids":[1]}`, nil},
+		{"boolean id", `{"ids":[true]}`, nil},
+		{"object id", `{"ids":[{}]}`, nil},
+		{"duplicate", `{"ids":["a","a"]}`, nil},
+		{"escaped duplicate", `{"ids":["a","\u0061"]}`, nil},
+		{"too many", string(tooMany), nil},
+		{"too long", `{"ids":["` + strings.Repeat("a", 101) + `"]}`, nil},
+		{"too many UTF8 bytes", `{"ids":["` + strings.Repeat("界", 34) + `"]}`, nil},
+		{"unknown field", `{"ids":["a"],"tenant":"tenant-b"}`, nil},
+		{"unknown first field", `{"role":"approver","ids":["a"]}`, nil},
+		{"case sensitive", `{"IDS":["a"]}`, nil},
+		{"repeated field", `{"ids":["a"],"ids":["b"]}`, nil},
+		{"trailing object", `{"ids":["a"]}{}`, nil},
+		{"trailing invalid", `{"ids":["a"]}x`, nil},
+		{"truncated", `{"ids":["a"]`, nil},
+		{"trailing comma", `{"ids":["a"],}`, nil},
+		{"invalid UTF8", "{\"ids\":[\"\xff\"]}", nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := bulkApprovalIDs(strings.NewReader(tt.body))
+			if tt.want == nil {
+				if err == nil {
+					t.Fatalf("accepted invalid body: %q", tt.body)
+				}
+				return
+			}
+			if err != nil || !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("got %v, %v; want %v", got, err, tt.want)
+			}
+		})
+	}
+}
