@@ -0,0 +1,51 @@
+package app
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestBulkApprovalIDs(t *testing.T) {
+	for _, body := range []string{
+		``, `null`, `[]`, `"ids"`, `{}`, `{"ids":null}`, `{"ids":[]}`,
+		`{"ids":"a"}`, `{"ids":{}}`, `{"ids":[1]}`, `{"ids":[true]}`,
+		`{"ids":[null]}`, `{"ids":[""]}`, `{"ids":["a","a"]}`,
+		`{"ids":["a"],"role":"approver"}`, `{"ids":["a"],"tenantId":"tenant-a"}`,
+		`{"ids":["a"],"createdBy":"alice"}`, `{"ids":["a"],"internalNote":"x"}`,
+		`{"ids":["a"],"ids":["b"]}`, `{"Ids":["a"]}`,
+		`{"ids":["a"]} {}`, `{"ids":["a"]} null`, `{"ids":["a"],}`,
+		`{"ids":["` + strings.Repeat("x", 101) + `"]}`,
+		`{"ids":["` + strings.Repeat("界", 34) + `"]}`,
+		"{\"ids\":[\"\xff\"]}",
+	} {
+		t.Run(body, func(t *testing.T) {
+			if ids, err := bulkApprovalIDs(strings.NewReader(body)); err == nil {
+				t.Fatalf("accepted invalid body, ids=%q", ids)
+			}
+		})
+	}
+	ids, err := bulkApprovalIDs(strings.NewReader(`{"ids":["z","a","界"]}`))
+	if err != nil || !reflect.DeepEqual(ids, []string{"a", "z", "界"}) {
+		t.Fatalf("unexpected sorted IDs: %q, %v", ids, err)
+	}
+	for _, count := range []int{1, 100, 101} {
+		ids := make([]string, count)
+		for i := range ids {
+			ids[i] = fmt.Sprintf("%03d", i) + strings.Repeat("x", 97)
+		}
+		body, err := json.Marshal(map[string][]string{"ids": ids})
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := bulkApprovalIDs(strings.NewReader(string(body)))
+		if count <= 100 && (err != nil || !reflect.DeepEqual(got, ids)) {
+			t.Fatalf("rejected valid %d-item batch: %v", count, err)
+		}
+		if count > 100 && err == nil {
+			t.Fatal("accepted more than 100 IDs")
+		}
+	}
+}
