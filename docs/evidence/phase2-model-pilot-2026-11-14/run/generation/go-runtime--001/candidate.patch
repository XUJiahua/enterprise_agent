@@ -0,0 +1,117 @@
+package app
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"sort"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5"
+)
+
+var errInvalidBatch = errors.New("invalid approval batch")
+
+// Decode the object explicitly so duplicate keys, unknown keys, and trailing
+// JSON values cannot silently change the requested batch.
+func bulkApprovalIDs(body io.Reader) ([]string, error) {
+	b, err := io.ReadAll(body)
+	if err != nil || !utf8.Valid(b) {
+		return nil, errInvalidBatch
+	}
+	d := json.NewDecoder(bytes.NewReader(b))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, errInvalidBatch
+	}
+	var ids []string
+	seenField := false
+	for d.More() {
+		key, err := d.Token()
+		if err != nil || key != "ids" || seenField {
+			return nil, errInvalidBatch
+		}
+		seenField = true
+		if err := d.Decode(&ids); err != nil {
+			return nil, errInvalidBatch
+		}
+	}
+	if token, err = d.Token(); err != nil || token != json.Delim('}') {
+		return nil, errInvalidBatch
+	}
+	if _, err = d.Token(); err != io.EOF || len(ids) < 1 || len(ids) > 100 {
+		return nil, errInvalidBatch
+	}
+	seen := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		if id == "" || len(id) > 100 || seen[id] {
+			return nil, errInvalidBatch
+		}
+		seen[id] = true
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+
+func (s *Server) bulkApprove(r *http.Request, tx pgx.Tx, u Identity) (any, int, error) {
+	ids, err := bulkApprovalIDs(r.Body)
+	if err != nil {
+		return nil, http.StatusBadRequest, nil
+	}
+	if u.Role != "approver" {
+		return nil, http.StatusForbidden, nil
+	}
+	for _, id := range ids {
+		// PostgreSQL text cannot contain NUL, so such an ID cannot exist.
+		if strings.ContainsRune(id, 0) {
+			return nil, http.StatusNotFound, nil
+		}
+	}
+	ctx := r.Context()
+	// Lock in a consistent database order before any writes. Under READ COMMITTED,
+	// a waiter sees the updated status after a concurrent approver commits.
+	rows, err := tx.Query(ctx, `SELECT id,"createdBy",status FROM "Purchase"
+		WHERE "tenantId"=$1 AND id=ANY($2::text[]) ORDER BY id FOR UPDATE`, u.Tenant, ids)
+	if err != nil {
+		return nil, 0, err
+	}
+	count, status := 0, http.StatusOK
+	for rows.Next() {
+		var id, creator, state string
+		if err := rows.Scan(&id, &creator, &state); err != nil {
+			rows.Close()
+			return nil, 0, err
+		}
+		count++
+		if creator == u.User {
+			status = http.StatusForbidden
+		} else if state != "submitted" && status == http.StatusOK {
+			status = http.StatusConflict
+		}
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, 0, err
+	}
+	if count != len(ids) {
+		return nil, http.StatusNotFound, nil
+	}
+	if status != http.StatusOK {
+		return nil, status, nil
+	}
+	result, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='approved'
+		WHERE "tenantId"=$1 AND id=ANY($2::text[]) AND "createdBy"<>$3 AND status='submitted'`, u.Tenant, ids, u.User)
+	if err != nil {
+		return nil, 0, err
+	}
+	if result.RowsAffected() != int64(len(ids)) {
+		// ServeHTTP rolls back every error response, including any updates already
+		// made by this statement and any associated transactional metadata.
+		return nil, http.StatusConflict, nil
+	}
+	return map[string][]string{"approvedIds": ids}, http.StatusOK, nil
+}
