@@ -0,0 +1,105 @@
+package app
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"sort"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Decode the envelope explicitly so duplicate fields, null, and trailing JSON
+// cannot silently change the meaning of the request.
+func bulkApprovalIDs(body io.Reader) ([]string, error) {
+	b, err := io.ReadAll(http.MaxBytesReader(nil, io.NopCloser(body), 65536))
+	if err != nil {
+		return nil, err
+	}
+	if !utf8.Valid(b) {
+		return nil, fmt.Errorf("invalid UTF-8")
+	}
+	d := json.NewDecoder(bytes.NewReader(b))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') || !d.More() {
+		return nil, fmt.Errorf("expected ids object")
+	}
+	key, err := d.Token()
+	if err != nil || key != "ids" {
+		return nil, fmt.Errorf("expected ids field")
+	}
+	var ids []string
+	if err = d.Decode(&ids); err != nil {
+		return nil, err
+	}
+	if d.More() {
+		return nil, fmt.Errorf("unexpected field")
+	}
+	if token, err = d.Token(); err != nil || token != json.Delim('}') {
+		return nil, fmt.Errorf("expected end of object")
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return nil, fmt.Errorf("unexpected trailing data")
+	}
+	if len(ids) < 1 || len(ids) > 100 {
+		return nil, fmt.Errorf("expected 1 to 100 ids")
+	}
+	seen := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		if id == "" || len(id) > 100 || seen[id] {
+			return nil, fmt.Errorf("invalid or duplicate id")
+		}
+		seen[id] = true
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+
+func (s *Server) bulkApprove(r *http.Request, tx pgx.Tx, u Identity) (any, int, error) {
+	ids, err := bulkApprovalIDs(r.Body)
+	if err != nil {
+		return nil, http.StatusBadRequest, nil
+	}
+	if u.Role != "approver" {
+		return nil, http.StatusForbidden, nil
+	}
+	ctx := r.Context()
+	// Lock in a consistent order across batches. A concurrent approval must
+	// finish before we inspect its row, so it cannot pass the submitted check
+	// twice. Do not write anything until every target passes validation.
+	for _, id := range ids {
+		// PostgreSQL text IDs cannot contain NUL, so such a target cannot exist.
+		if strings.IndexByte(id, 0) >= 0 {
+			return nil, http.StatusNotFound, nil
+		}
+		var creator, status string
+		err = tx.QueryRow(ctx, `SELECT "createdBy",status FROM "Purchase"
+			WHERE id=$1 AND "tenantId"=$2 FOR UPDATE`, id, u.Tenant).Scan(&creator, &status)
+		if err != nil {
+			return nil, 0, err
+		}
+		if creator == u.User {
+			return nil, http.StatusForbidden, nil
+		}
+		if status != "submitted" {
+			return nil, http.StatusConflict, nil
+		}
+	}
+	result, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='approved'
+		WHERE id=ANY($1::text[]) AND "tenantId"=$2
+		AND "createdBy"<>$3 AND status='submitted'`, ids, u.Tenant, u.User)
+	if err != nil {
+		return nil, 0, err
+	}
+	if result.RowsAffected() != int64(len(ids)) {
+		// The caller rolls back every non-success result, including any updates.
+		return nil, http.StatusConflict, nil
+	}
+	return struct {
+		ApprovedIDs []string `json:"approvedIds"`
+	}{ids}, http.StatusOK, nil
+}
diff --git a/internal/app/bulk_approve_test.go b/internal/app/bulk_approve_test.go
