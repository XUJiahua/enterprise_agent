@@ -0,0 +1,142 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"net/http/httptest"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+)
+
+func TestBulkApprovalIDs(t *testing.T) {
+	for _, body := range []string{
+		``, `null`, `[]`, `{}`, `{"ids":null}`, `{"ids":[]}`,
+		`{"ids":"a"}`, `{"ids":{}}`, `{"ids":[1]}`, `{"ids":[true]}`,
+		`{"ids":[null]}`, `{"ids":[""]}`, `{"ids":["a","a"]}`,
+		`{"ids":["a"],"tenantId":"other"}`, `{"ids":["a"],"creator":"bob"}`,
+		`{"ids":["a"],"role":"approver"}`, `{"ids":["a"],"internalNote":"x"}`,
+		`{"ids":["a"],"ids":["b"]}`, `{"IDS":["a"]}`,
+		`{"ids":["a"]} {}`, `{"ids":["a"]} garbage`, `{"ids":["a"`,
+		`{"ids":["` + strings.Repeat("a", 101) + `"]}`,
+		`{"ids":["` + strings.Repeat("界", 34) + `"]}`,
+		"{\"ids\":[\"\xff\"]}",
+	} {
+		t.Run(body, func(t *testing.T) {
+			if ids, err := bulkApprovalIDs(strings.NewReader(body)); err == nil {
+				t.Fatalf("accepted invalid body: %q", ids)
+			}
+		})
+	}
+	ids := make([]string, 101)
+	for i := range ids {
+		ids[i] = strconv.Itoa(i)
+	}
+	b, _ := json.Marshal(map[string]any{"ids": ids})
+	if _, err := bulkApprovalIDs(strings.NewReader(string(b))); err == nil {
+		t.Fatal("accepted 101 ids")
+	}
+	b, _ = json.Marshal(map[string]any{"ids": ids[:100]})
+	if got, err := bulkApprovalIDs(strings.NewReader(string(b))); err != nil || len(got) != 100 {
+		t.Fatalf("rejected 100 valid ids: %v", err)
+	}
+	want := []string{"a", "z", strings.Repeat("界", 33) + "a"}
+	b, _ = json.Marshal(map[string]any{"ids": []string{want[2], "z", "a"}})
+	if got, err := bulkApprovalIDs(strings.NewReader(string(b))); err != nil || !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %q, %v; want %q", got, err, want)
+	}
+}
+
+type bulkRow struct {
+	creator, status string
+	err             error
+}
+
+func (r bulkRow) Scan(dest ...any) error {
+	if r.err != nil {
+		return r.err
+	}
+	*dest[0].(*string) = r.creator
+	*dest[1].(*string) = r.status
+	return nil
+}
+
+type bulkTx struct {
+	pgx.Tx
+	rows   map[string]bulkRow
+	locked []string
+	writes int
+}
+
+func (tx *bulkTx) QueryRow(_ context.Context, query string, args ...any) pgx.Row {
+	if !strings.Contains(query, "FOR UPDATE") || !strings.Contains(query, `"tenantId"=$2`) || args[1] != "tenant-a" {
+		panic("missing lock or tenant scope")
+	}
+	id := args[0].(string)
+	tx.locked = append(tx.locked, id)
+	row, ok := tx.rows[id]
+	if !ok {
+		return bulkRow{err: pgx.ErrNoRows}
+	}
+	return row
+}
+
+func (tx *bulkTx) Exec(_ context.Context, _ string, args ...any) (pgconn.CommandTag, error) {
+	tx.writes++
+	if !reflect.DeepEqual(args, []any{[]string{"a", "b"}, "tenant-a", "bob"}) {
+		panic("incorrect update scope")
+	}
+	return pgconn.NewCommandTag("UPDATE 2"), nil
+}
+
+func TestBulkApprovalValidationBeforeWrites(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		row  bulkRow
+		code int
+	}{
+		{"own", bulkRow{creator: "bob", status: "submitted"}, 403},
+		{"approved", bulkRow{creator: "alice", status: "approved"}, 409},
+		{"missing", bulkRow{err: pgx.ErrNoRows}, 0},
+		{"success", bulkRow{creator: "alice", status: "submitted"}, 200},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tx := &bulkTx{rows: map[string]bulkRow{
+				"a": {creator: "alice", status: "submitted"}, "b": tc.row,
+			}}
+			r := httptest.NewRequest("POST", "/purchases/bulk-approve", strings.NewReader(`{"ids":["b","a"]}`))
+			result, code, err := (&Server{}).handle(r, tx, identities["demo_bob"])
+			if code != tc.code || (err != nil) != (tc.name == "missing") {
+				t.Fatalf("code=%d err=%v", code, err)
+			}
+			if !reflect.DeepEqual(tx.locked, []string{"a", "b"}) {
+				t.Fatalf("unexpected lock order: %q", tx.locked)
+			}
+			if tc.code == 200 {
+				b, _ := json.Marshal(result)
+				if string(b) != `{"approvedIds":["a","b"]}` || tx.writes != 1 {
+					t.Fatalf("unexpected result %s; writes=%d", b, tx.writes)
+				}
+			} else if tx.writes != 0 {
+				t.Fatal("failed batch mutated data")
+			}
+		})
+	}
+}
+
+func TestBulkApprovalRequiresIdentityAndRole(t *testing.T) {
+	r := httptest.NewRequest("POST", "/purchases/bulk-approve", strings.NewReader(`{"ids":["a"]}`))
+	w := httptest.NewRecorder()
+	(&Server{}).ServeHTTP(w, r)
+	if w.Code != 401 {
+		t.Fatalf("anonymous request: %d", w.Code)
+	}
+	_, code, err := (&Server{}).handle(r, nil, identities["demo_alice"])
+	if code != 403 || err != nil {
+		t.Fatalf("requester: code=%d err=%v", code, err)
+	}
+}
