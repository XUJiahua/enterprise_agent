diff --git a/internal/candidate/approval_test.go b/internal/candidate/approval_test.go
new file mode 100644
index 0000000..3d7b991
--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,20 @@
+package candidate
+
+import (
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+)
+
+// Reconciliation recomputes requestHash from the row's own operation.
+func TestFingerprintMatchesLedger(t *testing.T) {
+	ids := []string{"a", "b", "é"}
+	for _, op := range []string{opApprove, opReject} {
+		if got, want := fingerprint(op, ids), ledger.Fingerprint(op, ids); got != want {
+			t.Fatalf("%s: fingerprint %s != ledger %s", op, got, want)
+		}
+	}
+	if fingerprint(opApprove, ids) == fingerprint(opReject, ids) {
+		t.Fatal("operations must use distinct hash domains")
+	}
+}
