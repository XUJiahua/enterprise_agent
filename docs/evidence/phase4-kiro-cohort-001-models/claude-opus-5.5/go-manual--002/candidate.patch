+++ b/internal/candidate/reject.go
@@ -0,0 +1,134 @@
+// Hand-written batch rejection, mirroring bulk approval: status change,
+// per-target audit and the completed idempotent result commit in one
+// transaction.
+package candidate
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const (
+	opReject    = "bulk-reject.v4"
+	rejectField = "rejectedIds"
+)
+
+// rejectHandler returns the protocol.Handler for POST /purchases/bulk-reject.
+// The adapter has already authenticated an approver, validated the single
+// Idempotency-Key and canonicalised ids (sorted by bytes, unique, 1..100).
+func rejectHandler(pool *pgxpool.Pool) protocol.Handler {
+	return func(ctx context.Context, u app.Identity, key string, ids []string) (protocol.Result, bool, error) {
+		for _, id := range ids {
+			if strings.ContainsRune(id, 0) {
+				return protocol.Result{}, false, &protocol.Rejection{Status: 404}
+			}
+		}
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		defer tx.Rollback(ctx)
+		// Guarded RLS context comes only from the authenticated identity.
+		_, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role)
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		// Serialise same (operation, tenant, actor, key) requests so a concurrent
+		// duplicate waits and then replays the committed result.
+		lock, _ := json.Marshal([]string{opReject, u.Tenant, u.User, key})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.Result{}, false, err
+		}
+		// Reconciliation recomputes ledger.Fingerprint(row.operation, ids).
+		hash := ledger.Fingerprint(opReject, ids)
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest"
+		 WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`, u.Tenant, u.User, opReject, key).Scan(&savedHash, &saved)
+		if err == nil {
+			if savedHash != hash {
+				return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+			}
+			var body map[string][]string
+			if err = json.Unmarshal(saved, &body); err != nil {
+				return protocol.Result{}, false, err
+			}
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.Result{}, false, err
+			}
+			return protocol.Result{Field: rejectField, IDs: body[rejectField]}, true, nil
+		}
+		if !errors.Is(err, pgx.ErrNoRows) {
+			return protocol.Result{}, false, err
+		}
+		// Same lock order as bulk approval (ORDER BY id) so overlapping approve
+		// and reject batches block rather than deadlock; the loser re-checks
+		// status after the winner commits and is rejected below.
+		rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`, ids, u.Tenant, u.User)
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		eligible := 0
+		for rows.Next() {
+			var id string
+			if err = rows.Scan(&id); err != nil {
+				rows.Close()
+				return protocol.Result{}, false, err
+			}
+			eligible++
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		// Missing, other-tenant, own and already-decided targets are
+		// indistinguishable (409); the whole batch is refused.
+		if eligible != len(ids) {
+			return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+		}
+		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='rejected' WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted'`, ids, u.Tenant, u.User)
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		if tag.RowsAffected() != int64(len(ids)) {
+			return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+		}
+		// Every status transition leaves one ApprovalAudit row per target.
+		_, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus")
+		 SELECT $2,id,$3,$4,$5,'submitted','rejected' FROM unnest($1::text[]) AS id`, ids, u.Tenant, u.User, opReject, key)
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		result := protocol.Result{Field: rejectField, IDs: ids}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		_, err = tx.Exec(ctx, `INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response)
+		 VALUES ($1,$2,$3,$4,$5,$6::jsonb)`, u.Tenant, u.User, opReject, key, hash, string(response))
+		if err != nil {
+			// Any metadata write failure is a service fault (503), never a
+			// client conflict; the rollback leaves the database unchanged.
+			return protocol.Result{}, false, actionRequestFailure{err}
+		}
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.Result{}, false, err
+		}
+		return result, false, nil
+	}
+}
+
+// actionRequestFailure hides the underlying PgError from the adapter so a
+// failed ActionRequest write (including an injected 23505) maps to 503.
+type actionRequestFailure struct{ cause error }
+
+func (e actionRequestFailure) Error() string { return "ActionRequest write failed: " + e.cause.Error() }
