index 0000000..9982442
--- /dev/null
+++ b/internal/candidate/fingerprint_test.go
@@ -0,0 +1,20 @@
+package candidate
+
+import (
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+)
+
+// Reconciliation recomputes requestHash with each row's own operation.
+func TestFingerprintMatchesLedger(t *testing.T) {
+	ids := []string{"a", "b", "z", "é"} // canonical UTF-8 byte order, as protocol.HTTP delivers
+	for _, op := range []string{opApprove, opReject} {
+		if fingerprint(op, ids) != ledger.Fingerprint(op, ids) {
+			t.Fatalf("fingerprint mismatch for %s", op)
+		}
+	}
+	if fingerprint(opApprove, ids) == fingerprint(opReject, ids) {
+		t.Fatal("operations must be domain separated")
+	}
+}
