diff --git a/internal/candidate/approval_test.go b/internal/candidate/approval_test.go
new file mode 100644
index 0000000..c6c60a3
--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,33 @@
+package candidate
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/ledger"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+// The stored requestHash must match what nightly reconciliation recomputes
+// from the row's operation and response IDs.
+func TestFingerprintMatchesLedger(t *testing.T) {
+	ids := []string{"a", "b:1", "é", "中"}
+	for _, op := range []string{opApprove, opReject} {
+		if got, want := fingerprint(op, ids), ledger.Fingerprint(op, ids); got != want {
+			t.Fatalf("%s: fingerprint %s != ledger %s", op, got, want)
+		}
+	}
+	if fingerprint(opApprove, ids) == fingerprint(opReject, ids) {
+		t.Fatal("operations must be domain-separated")
+	}
+}
+
+func TestRejectResponseShape(t *testing.T) {
+	b, err := json.Marshal(protocol.Result{Field: "rejectedIds", IDs: []string{"p1", "p2"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != `{"rejectedIds":["p1","p2"]}` {
+		t.Fatalf("unexpected response %s", b)
+	}
+}
