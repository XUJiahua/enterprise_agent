+++ b/internal/candidate/reject.go
@@ -0,0 +1,30 @@
+// Batch rejection through the platform Action kernel.
+package candidate
+
+import (
+	"context"
+	"errors"
+
+	"github.com/XUJiahua/enterprise_agent/internal/action"
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+// Reject is the v4 batch rejection Action: submitted -> rejected.
+var Reject = action.Transition{Operation: "bulk-reject.v4", From: "submitted", To: "rejected", Field: "rejectedIds"}
+
+// actionHandler adapts a kernel Transition to a protocol.Handler, translating
+// action.Rejection into protocol.Rejection at the boundary.
+func actionHandler(executor *action.Executor, t action.Transition) protocol.Handler {
+	return func(ctx context.Context, u app.Identity, key string, ids []string) (protocol.Result, bool, error) {
+		done, replayed, err := executor.Run(ctx, u, t, key, ids)
+		var denied *action.Rejection
+		if errors.As(err, &denied) {
+			return protocol.Result{}, false, &protocol.Rejection{Status: denied.Status}
+		}
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
+		return protocol.Result{Field: t.Field, IDs: done}, replayed, nil
+	}
+}
