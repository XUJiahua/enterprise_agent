+		u.Tenant, u.User, "bulk-approve.v3", key).Scan(&existingApprovedIDs)
+	
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	
+	var result protocol.Result
+	if err := json.Unmarshal([]byte(`{"approvedIds":`+existingApprovedIDs+`}`), &result); err != nil {
+		return protocol.Result{}, false, err
+	}
+	
+	return result, true, nil
