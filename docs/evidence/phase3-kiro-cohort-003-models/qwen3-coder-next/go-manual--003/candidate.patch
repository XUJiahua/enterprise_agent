+// buildRequestHash builds the SHA-256 hash for ActionRequest.requestHash
+// Input: "bulk-approve.v3" + newline, then each sorted ID as "<UTF-8 byte length>:<ID>"
+func buildRequestHash(ids []string) string {
+	// Sort IDs by UTF-8 byte order (lexicographic)
+	sorted := append([]string(nil), ids...)
+	sort.Strings(sorted)
+	
+	// Build the hash input
+	hashInput := "bulk-approve.v3\n"
+	for _, id := range sorted {
+		hashInput += fmt.Sprintf("%d:%s", len([]byte(id)), id)
+	}
+	
+	// SHA-256
+	hash := sha256.Sum256([]byte(hashInput))
+	return hex.EncodeToString(hash[:])
+}
