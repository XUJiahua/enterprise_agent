+		}
+
 		if err = tx.Commit(ctx); err != nil {
 			return protocol.Result{}, false, err
 		}
-		return protocol.Result{ApprovedIDs: ids}, false, nil
+
+		return protocol.Result{ApprovedIDs: sortedIDs}, false, nil
 	}
 	return protocol.HTTP(approve, fallback), nil
 }
+
+// generateScopeKey creates a unique scope identifier
+func generateScopeKey(u app.Identity, key string) string {
+	return u.Tenant + "|" + u.User + "|" + key
+}
+
+// idSetsEqual checks if two sets of IDs are equal
+func idSetsEqual(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// calculateRequestHash calculates SHA-256 hash for ActionRequest.requestHash
+func calculateRequestHash(ids []string) string {
+	// "bulk-approve.v3" + newline + sorted IDs with length prefix
+	input := "bulk-approve.v3\n"
+	for _, id := range ids {
+		input += strconv.Itoa(len(id)) + ":" + id
+	}
+	hash := sha256.Sum256([]byte(input))
+	return hex.EncodeToString(hash[:])
+}
