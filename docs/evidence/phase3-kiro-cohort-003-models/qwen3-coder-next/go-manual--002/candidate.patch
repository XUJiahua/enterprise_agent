+		// Insert ApprovalAudit for each approved purchase
+		for _, id := range sortedIDs {
+			_, err = tx.Exec(ctx,
+				`INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus","createdAt") VALUES ($1,$2,$3,$4,$5,$6,$7,now())`,
+				u.Tenant, id, u.User, "bulk-approve.v3", key, "submitted", "approved")
+			if err != nil {
+				return protocol.Result{}, false, err
