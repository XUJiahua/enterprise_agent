 func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.Handler, error) {
 	approve := func(ctx context.Context, u app.Identity, key string, ids []string) (protocol.Result, bool, error) {
+		// Check for null bytes in IDs
 		for _, id := range ids {
 			if strings.ContainsRune(id, 0) {
 				return protocol.Result{}, false, &protocol.Rejection{Status: 404}
 			}
 		}
+
 		tx, err := pool.Begin(ctx)
 		if err != nil {
 			return protocol.Result{}, false, err
 		}
 		defer tx.Rollback(ctx)
+
+		// Set session context
 		_, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role)
 		if err != nil {
 			return protocol.Result{}, false, err
 		}
+
+		// Check if idempotency key already exists for this scope
+		var existingResponse string
+		err = tx.QueryRow(ctx, `SELECT response FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`, u.Tenant, u.User, "bulk-approve.v3", key).Scan(&existingResponse)
+		if err == nil {
+			// Found existing request - check if it's the same set of IDs
+			var existingIDs []string
+			if err := json.Unmarshal([]byte(existingResponse), &existingIDs); err == nil {
+				if idSetsEqual(existingIDs, ids) {
+					// Same scope, same IDs - replay with same result
+					return protocol.Result{ApprovedIDs: existingIDs}, true, nil
+				}
+				// Same key but different IDs - conflict
+				return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+			}
+		} else if err != pgx.ErrNoRows {
+			return protocol.Result{}, false, err
+		}
+
+		// Query eligible purchases with FOR UPDATE lock
 		rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`, ids, u.Tenant, u.User)
 		if err != nil {
 			return protocol.Result{}, false, err
@@ -39,14 +68,23 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 			}
 			eligible = append(eligible, id)
 		}
-		err = rows.Err()
-		rows.Close()
-		if err != nil {
+		if err = rows.Err(); err != nil {
+			rows.Close()
 			return protocol.Result{}, false, err
 		}
+		rows.Close()
+
+		// If any target is invalid, reject all
 		if len(eligible) != len(ids) {
 			return protocol.Result{}, false, &protocol.Rejection{Status: 409}
 		}
+
+		// Sort IDs for consistent ordering
+		sortedIDs := make([]string, len(ids))
+		copy(sortedIDs, ids)
+		sort.Strings(sortedIDs)
+
+		// Update all purchases
 		tag, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='approved' WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted'`, ids, u.Tenant, u.User)
 		if err != nil {
 			return protocol.Result{}, false, err
@@ -54,10 +92,62 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 		if tag.RowsAffected() != int64(len(ids)) {
 			return protocol.Result{}, false, &protocol.Rejection{Status: 409}
 		}
+
+		// Insert ActionRequest for idempotency
+		requestHash := calculateRequestHash(sortedIDs)
+		responseJSON, _ := json.Marshal(map[string][]string{"approvedIds": sortedIDs})
+		
+		_, err = tx.Exec(ctx, 
+			`INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response,"createdAt") VALUES ($1,$2,$3,$4,$5,$6,now())`,
+			u.Tenant, u.User, "bulk-approve.v3", key, requestHash, string(responseJSON))
+		if err != nil {
+			return protocol.Result{}, false, err
+		}
