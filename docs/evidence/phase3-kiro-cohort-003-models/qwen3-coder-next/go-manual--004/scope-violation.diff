+
+func sameSet(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func computeRequestHash(ids []string) string {
+	// SHA-256 of "bulk-approve.v3\n" + sorted IDs as "<length>:<ID>"
+	h := sha256.New()
+	h.Write([]byte("bulk-approve.v3\n"))
+	for _, id := range ids {
+		fmt.Fprintf(h, "%d:%s", len(id), id)
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
