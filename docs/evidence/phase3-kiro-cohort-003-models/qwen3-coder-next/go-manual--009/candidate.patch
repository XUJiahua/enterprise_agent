+// formatIDsForJSON formats IDs for JSON array output
+func formatIDsForJSON(ids []string) string {
+	if len(ids) == 0 {
+		return ""
+	}
+	parts := make([]string, len(ids))
+	for i, id := range ids {
+		parts[i] = fmt.Sprintf(`"%s"`, id)
+	}
+	return strings.Join(parts, ",")
