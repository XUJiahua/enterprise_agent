+// computeRequestHash computes the SHA-256 input for ActionRequest.requestHash
+// Format: "bulk-approve.v3\n" + sorted IDs with format "<length>:<id>" (no separator)
+func computeRequestHash(ids []string) string {
+	var sb strings.Builder
+	sb.WriteString("bulk-approve.v3\n")
+	for _, id := range ids {
+		sb.WriteString(strconv.Itoa(len(id)))
+		sb.WriteString(":")
+		sb.WriteString(id)
+	}
+	return sb.String()
