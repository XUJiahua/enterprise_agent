+// computeRequestHash computes SHA-256 of "bulk-approve.v3\n" + formatted IDs
+func computeRequestHash(ids []string) string {
+	h := sha256.New()
+	h.Write([]byte(operation))
+	h.Write([]byte("\n"))
+	
+	for _, id := range ids {
+		// Format: <UTF-8 byte length>:<ID>
+		idBytes := []byte(id)
+		h.Write([]byte(fmt.Sprintf("%d:", len(idBytes))))
+		h.Write(idBytes)
+	}
+	
+	return hex.EncodeToString(h.Sum(nil))
