+// computeHash produces a lowercase hex SHA-256 of "bulk-approve.v3\n" followed by
+// sorted IDs in format "<UTF-8 byte length>:<ID>", with no separators between IDs.
+func computeHash(ids []string) string {
+	h := sha256.New()
+	fmt.Fprint(h, Operation, "\n")
+	for _, id := range ids {
+		fmt.Fprintf(h, "%d:%s", len(id), id)
+	}
+	return hex.EncodeToString(h.Sum(nil))
