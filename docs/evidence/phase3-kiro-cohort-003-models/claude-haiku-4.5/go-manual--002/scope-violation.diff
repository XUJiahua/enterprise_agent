+// computeRequestHash computes SHA-256 of "bulk-approve.v3\n" followed by
+// each sorted ID formatted as "<utf8-byte-length>:<id>" (no separators).
+func computeRequestHash(ids []string) string {
+	h := sha256.New()
+	h.Write([]byte("bulk-approve.v3\n"))
+
+	// IDs are already sorted by protocol.decode/canonical
+	sorted := append([]string(nil), ids...)
+	sort.Strings(sorted)
+
+	for _, id := range sorted {
+		idBytes := []byte(id)
+		h.Write([]byte(fmt.Sprintf("%d:%s", len(idBytes), id)))
+	}
+
+	return hex.EncodeToString(h.Sum(nil))
+}
