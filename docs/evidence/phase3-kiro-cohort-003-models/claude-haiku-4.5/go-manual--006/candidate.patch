+// computeRequestHash computes SHA-256 of the request format:
+// "bulk-approve.v3\n" + each ID formatted as "<UTF-8_byte_length>:<ID>"
+func computeRequestHash(ids []string) string {
+	h := sha256.New()
+	h.Write([]byte("bulk-approve.v3\n"))
+	for _, id := range ids {
+		// IDs are already sorted and validated by canonical() in protocol
+		idBytes := []byte(id)
+		h.Write([]byte(fmt.Sprintf("%d:%s", len(idBytes), id)))
+	}
+	return hex.EncodeToString(h.Sum(nil))
