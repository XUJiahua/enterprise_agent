+// computeRequestHash computes SHA-256 of "bulk-approve.v3\n" + sorted IDs with format "<utf8_byte_length>:<id>"
+func computeRequestHash(ids []string) string {
+	h := sha256.New()
+	h.Write([]byte("bulk-approve.v3\n"))
+
+	// Ensure IDs are sorted
+	sortedIDs := make([]string, len(ids))
+	copy(sortedIDs, ids)
+	sort.Strings(sortedIDs)
+
+	for _, id := range sortedIDs {
+		idBytes := []byte(id)
+		idLen := len(idBytes)
+		lengthStr := fmt.Sprintf("%d:", idLen)
+		h.Write([]byte(lengthStr))
+		h.Write(idBytes)
+	}
+
+	return hex.EncodeToString(h.Sum(nil))
