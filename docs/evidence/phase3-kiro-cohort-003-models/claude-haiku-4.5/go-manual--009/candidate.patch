diff --git a/internal/candidate/approval_test.go b/internal/candidate/approval_test.go
new file mode 100644
index 0000000..00f9221
--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,101 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"sort"
+	"testing"
+)
+
+// TestComputeRequestHash verifies the SHA-256 hash computation matches the specification.
+func TestComputeRequestHash(t *testing.T) {
+	tests := []struct {
+		name     string
+		ids      []string
+		expected string
+	}{
+		{
+			name: "single id",
+			ids:  []string{"hello"},
+			// "bulk-approve.v3\n" + "5:hello" (5 bytes)
+			expected: computeExpected([]string{"hello"}),
+		},
+		{
+			name: "multiple ids sorted",
+			ids:  []string{"charlie", "alice", "bob"},
+			// Should be sorted: alice, bob, charlie
+			expected: computeExpected([]string{"alice", "bob", "charlie"}),
+		},
+		{
+			name: "already sorted",
+			ids:  []string{"alice", "bob", "charlie"},
+			expected: computeExpected([]string{"alice", "bob", "charlie"}),
+		},
+		{
+			name: "single character ids",
+			ids:  []string{"a", "b"},
+			expected: computeExpected([]string{"a", "b"}),
+		},
+		{
+			name: "utf8 ids",
+			ids:  []string{"id-1", "id-2"},
+			expected: computeExpected([]string{"id-1", "id-2"}),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			result := computeRequestHash(tt.ids)
+			if result != tt.expected {
+				t.Errorf("computeRequestHash(%v) = %s, want %s", tt.ids, result, tt.expected)
+			}
+		})
+	}
+}
+
+func computeExpected(ids []string) string {
+	h := sha256.New()
+	h.Write([]byte("bulk-approve.v3\n"))
+
+	sortedIDs := make([]string, len(ids))
+	copy(sortedIDs, ids)
+	sort.Strings(sortedIDs)
+
+	for _, id := range sortedIDs {
+		idBytes := []byte(id)
+		idLen := len(idBytes)
+		lengthStr := fmt.Sprintf("%d:", idLen)
+		h.Write([]byte(lengthStr))
+		h.Write(idBytes)
+	}
+
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+// TestRequestHashDeterministic verifies that the same IDs always produce the same hash
+func TestRequestHashDeterministic(t *testing.T) {
+	ids := []string{"zebra", "apple", "mango"}
+
+	hash1 := computeRequestHash(ids)
+	hash2 := computeRequestHash(ids)
+
+	if hash1 != hash2 {
+		t.Errorf("Hash should be deterministic, got %s and %s", hash1, hash2)
+	}
+}
+
+// TestRequestHashOrderIndependent verifies different orders produce the same hash
+func TestRequestHashOrderIndependent(t *testing.T) {
+	ids1 := []string{"zebra", "apple", "mango"}
+	ids2 := []string{"apple", "mango", "zebra"}
+	ids3 := []string{"mango", "zebra", "apple"}
+
+	hash1 := computeRequestHash(ids1)
+	hash2 := computeRequestHash(ids2)
+	hash3 := computeRequestHash(ids3)
+
+	if hash1 != hash2 || hash2 != hash3 {
+		t.Errorf("Hashes should be identical regardless of input order: %s, %s, %s", hash1, hash2, hash3)
+	}
+}
