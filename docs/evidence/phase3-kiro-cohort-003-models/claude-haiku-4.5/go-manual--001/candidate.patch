+// computeRequestHash computes SHA-256 of "bulk-approve.v3\n" + formatted IDs
+func computeRequestHash(ids []string) string {
+	hash := sha256.New()
+	hash.Write([]byte("bulk-approve.v3\n"))
+
+	for _, id := range ids {
+		// Format: "<UTF-8 byte length>:<ID>"
+		byteLen := len([]byte(id))
+		fmt.Fprintf(hash, "%d:%s", byteLen, id)
+	}
+
+	return hex.EncodeToString(hash.Sum(nil))
