+// canonicalIDs validates and returns sorted unique IDs
+func canonicalIDs(ids []string) ([]string, error) {
+	if len(ids) < 1 || len(ids) > 100 {
+		return nil, &protocol.Rejection{Status: 400}
+	}
+	result := append([]string(nil), ids...)
+	sort.Strings(result)
+	for i, id := range result {
+		if len(id) == 0 || len(id) > 100 || !isValidUTF8(id) || (i > 0 && result[i-1] == id) {
+			return nil, &protocol.Rejection{Status: 400}
+		}
+	}
+	return result, nil
+}
+
+// validKey validates idempotency key format
+func validKey(key string) bool {
+	if len(key) < 1 || len(key) > 128 {
+		return false
+	}
+	for _, c := range key {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("._:-", c)) {
+			return false
+		}
+	}
+	return true
+}
+
+// isValidUTF8 checks if a string is valid UTF-8
+func isValidUTF8(s string) bool {
+	return utf8.ValidString(s)
+}
+
+// fingerprint computes SHA-256 hash of sorted IDs in canonical format
+func fingerprint(ids []string) string {
+	h := sha256.New()
+	fmt.Fprint(h, Operation, "\n")
+	for _, id := range ids {
+		fmt.Fprintf(h, "%d:%s", len(id), id)
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
