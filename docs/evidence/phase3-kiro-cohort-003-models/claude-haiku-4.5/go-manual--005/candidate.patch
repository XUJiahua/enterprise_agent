+// computeRequestHash computes SHA-256 of "bulk-approve.v3\n" followed by sorted IDs formatted as "<utf8-length>:<id>"
+func computeRequestHash(ids []string) string {
+	h := sha256.New()
+	h.Write([]byte("bulk-approve.v3\n"))
+	for _, id := range ids {
+		idBytes := []byte(id)
+		h.Write([]byte(fmt.Sprintf("%d:%s", len(idBytes), id)))
+	}
+	return hex.EncodeToString(h.Sum(nil))
