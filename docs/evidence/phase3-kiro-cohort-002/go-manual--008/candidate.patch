@@ -0,0 +1,16 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func TestRequestHash(t *testing.T) {
+	// "é" is 2 UTF-8 bytes, so its length prefix is "2:".
+	sum := sha256.Sum256([]byte("bulk-approve.v3\n1:a2:bc2:é"))
+	want := hex.EncodeToString(sum[:])
+	if got := requestHash([]string{"a", "bc", "é"}); got != want {
+		t.Fatalf("requestHash = %s, want %s", got, want)
+	}
+}
