+func requestHash(sorted []string) string {
+	var b strings.Builder
+	b.WriteString(operation)
+	b.WriteByte('\n')
+	for _, id := range sorted {
+		b.WriteString(strconv.Itoa(len(id)))
+		b.WriteByte(':')
+		b.WriteString(id)
+	}
+	sum := sha256.Sum256([]byte(b.String()))
+	return hex.EncodeToString(sum[:])
