+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,12 @@
+package candidate
+
+import "testing"
+
+func TestRequestHash(t *testing.T) {
+	// Reference: printf 'bulk-approve.v3\n7:a-other5:a-own4:é-x' | shasum -a 256
+	// ("é" is 2 UTF-8 bytes, so "é-x" has length prefix 4.)
+	const want = "58860e48239f3c23049553410e9fedc83caf6cdaadd15553e3095bec74585a36"
+	if got := requestHash([]string{"a-other", "a-own", "é-x"}); got != want {
+		t.Fatalf("requestHash = %s, want %s", got, want)
+	}
+}
