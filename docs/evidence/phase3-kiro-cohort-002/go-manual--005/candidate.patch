+const operation = "bulk-approve.v3"
+
+// maxAttempts bounds transparent retries of transactions that PostgreSQL
+// aborted and rolled back itself (deadlock / serialization failure).
+const maxAttempts = 3
+
+// requestHash is lowercase hex SHA-256 of "bulk-approve.v3\n" followed by
+// "<byteLen>:<id>" for each ID in UTF-8 byte order, with no separators.
+func requestHash(sorted []string) string {
+	h := sha256.New()
+	h.Write([]byte(operation + "\n"))
+	for _, id := range sorted {
+		h.Write([]byte(strconv.Itoa(len(id))))
+		h.Write([]byte{':'})
+		h.Write([]byte(id))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
