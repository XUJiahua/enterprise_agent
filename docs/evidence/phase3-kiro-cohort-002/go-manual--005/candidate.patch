+func approveOnce(ctx context.Context, pool *pgxpool.Pool, u app.Identity, key string, sorted []string) (protocol.Result, bool, error) {
+	hash := requestHash(sorted)
+	response, err := json.Marshal(protocol.Result{ApprovedIDs: sorted})
+	if err != nil {
+		return protocol.Result{}, false, err
