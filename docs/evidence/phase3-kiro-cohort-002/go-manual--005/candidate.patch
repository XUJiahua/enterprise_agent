+	rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`, sorted, u.Tenant, u.User)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
