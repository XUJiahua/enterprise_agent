+// requestHash is lowercase hex SHA-256 of "bulk-approve.v3\n" followed by
+// "<byte length>:<id>" for every ID in UTF-8 byte order, without separators.
+func requestHash(sorted []string) string {
+	var b strings.Builder
+	b.WriteString(operation)
+	b.WriteByte('\n')
+	for _, id := range sorted {
+		b.WriteString(strconv.Itoa(len(id)))
+		b.WriteByte(':')
+		b.WriteString(id)
+	}
+	sum := sha256.Sum256([]byte(b.String()))
+	return hex.EncodeToString(sum[:])
+}
+
+func sameIDs(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
