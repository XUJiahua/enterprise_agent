--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,50 @@
+package candidate
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/action"
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+func TestAdaptSuccessAndReplay(t *testing.T) {
+	for _, replayed := range []bool{false, true} {
+		approve := adapt(func(context.Context, app.Identity, string, []string) (action.Result, bool, error) {
+			return action.Result{ApprovedIDs: []string{"a", "b"}}, replayed, nil
+		})
+		got, r, err := approve(context.Background(), app.Identity{}, "k", []string{"a", "b"})
+		if err != nil || r != replayed || !reflect.DeepEqual(got.ApprovedIDs, []string{"a", "b"}) {
+			t.Fatalf("replayed=%v: got %v %v %v", replayed, got, r, err)
+		}
+	}
+}
+
+func TestAdaptRejection(t *testing.T) {
+	for _, status := range []int{400, 403, 404, 409} {
+		approve := adapt(func(context.Context, app.Identity, string, []string) (action.Result, bool, error) {
+			return action.Result{}, false, fmt.Errorf("wrapped: %w", &action.Rejection{Status: status})
+		})
+		_, replayed, err := approve(context.Background(), app.Identity{}, "k", []string{"a"})
+		var rejected *protocol.Rejection
+		if replayed || !errors.As(err, &rejected) || rejected.Status != status {
+			t.Fatalf("status %d: got %v", status, err)
+		}
+	}
+}
+
+func TestAdaptPassesThroughOtherErrors(t *testing.T) {
+	sentinel := errors.New("db down")
+	approve := adapt(func(context.Context, app.Identity, string, []string) (action.Result, bool, error) {
+		return action.Result{}, false, sentinel
+	})
+	_, _, err := approve(context.Background(), app.Identity{}, "k", []string{"a"})
+	var rejected *protocol.Rejection
+	if !errors.Is(err, sentinel) || errors.As(err, &rejected) {
+		t.Fatalf("got %v", err)
+	}
+}
