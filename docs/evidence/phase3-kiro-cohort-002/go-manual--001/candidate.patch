--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,15 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func TestRequestHash(t *testing.T) {
+	sum := sha256.Sum256([]byte("bulk-approve.v3\n" + "7:a-other" + "5:a-own" + "3:é1"))
+	want := hex.EncodeToString(sum[:])
+	if got := requestHash([]string{"a-other", "a-own", "é1"}); got != want {
+		t.Fatalf("hash mismatch: got %s want %s", got, want)
+	}
+}
