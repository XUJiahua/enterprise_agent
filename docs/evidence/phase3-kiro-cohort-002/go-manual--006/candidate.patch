--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,14 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func TestRequestHash(t *testing.T) {
+	want := sha256.Sum256([]byte("bulk-approve.v3\n3:abc1:z2:é"))
+	if got := requestHash([]string{"abc", "z", "é"}); got != hex.EncodeToString(want[:]) {
+		t.Fatalf("hash mismatch: %s", got)
+	}
+}
