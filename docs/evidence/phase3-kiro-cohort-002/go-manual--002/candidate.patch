+// replay returns the stored result for an already-completed scope, or 409 if the
+// same key was used for a different target set. It performs no writes.
+func replay(ctx context.Context, tx pgx.Tx, u app.Identity, key, hash string) (protocol.Result, bool, error) {
+	var storedHash string
+	var stored []byte
+	err := tx.QueryRow(ctx, `SELECT "requestHash", response::text FROM "ActionRequest"
+		WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+		u.Tenant, u.User, operation, key).Scan(&storedHash, &stored)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	if storedHash != hash {
+		return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+	}
+	var result protocol.Result
+	if err = json.Unmarshal(stored, &result); err != nil {
+		return protocol.Result{}, false, err
+	}
+	if result.ApprovedIDs == nil {
+		result.ApprovedIDs = []string{}
+	}
+	return result, true, nil
+}
diff --git a/internal/candidate/approval_test.go b/internal/candidate/approval_test.go
new file mode 100644
index 0000000..8d7c523
--- /dev/null
+++ b/internal/candidate/approval_test.go
@@ -0,0 +1,18 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func TestRequestHashCanonical(t *testing.T) {
+	want := sha256.Sum256([]byte("bulk-approve.v3\n" + "1:a" + "2:bc" + "2:é"))
+	got := requestHash([]string{"é", "bc", "a"})
+	if got != hex.EncodeToString(want[:]) {
+		t.Fatalf("hash mismatch: %s", got)
+	}
+	if requestHash([]string{"a", "bc", "é"}) != got {
+		t.Fatal("hash must be order independent")
+	}
+}
