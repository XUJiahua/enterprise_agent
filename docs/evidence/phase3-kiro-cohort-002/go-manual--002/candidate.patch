+func requestHash(ids []string) string {
+	sorted := append([]string(nil), ids...)
+	sort.Strings(sorted) // Go string comparison is byte-wise, i.e. UTF-8 byte order.
+	h := sha256.New()
+	h.Write([]byte(operation + "\n"))
+	for _, id := range sorted {
+		h.Write([]byte(strconv.Itoa(len(id))))
+		h.Write([]byte{':'})
+		h.Write([]byte(id))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
