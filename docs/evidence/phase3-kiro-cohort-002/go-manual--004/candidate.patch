@@ -0,0 +1,31 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"testing"
+
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+)
+
+func TestRequestHash(t *testing.T) {
+	ids := sortedCopy([]string{"é", "b", "a:1"})
+	want := sha256.Sum256([]byte("bulk-approve.v3\n3:a:11:b2:é"))
+	if got := requestHash(ids); got != hex.EncodeToString(want[:]) {
+		t.Fatalf("hash mismatch: %s", got)
+	}
+	if requestHash([]string{"ab"}) == requestHash([]string{"a", "b"}) {
+		t.Fatal("length prefix must disambiguate")
+	}
+}
+
+func TestSortedResponse(t *testing.T) {
+	b, err := json.Marshal(protocol.Result{ApprovedIDs: sortedCopy([]string{"z", "Z", "é", "a"})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != `{"approvedIds":["Z","a","z","é"]}` {
+		t.Fatalf("unexpected response %s", b)
+	}
+}
