 		}
-		rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`, ids, u.Tenant, u.User)
+
+		// Claim the idempotency scope first. A concurrent uncommitted claim on the same
+		// primary key blocks here until it commits (conflict -> replay/409) or rolls back
+		// (we then insert and proceed), so a scope is completed at most once.
+		var claimed bool
+		err = tx.QueryRow(ctx, `INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response)
