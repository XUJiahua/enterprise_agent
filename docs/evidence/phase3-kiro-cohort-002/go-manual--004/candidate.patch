+// Operation identifies this Action in ActionRequest/ApprovalAudit and the request hash.
+const Operation = "bulk-approve.v3"
+
+// requestHash returns the lowercase hex SHA-256 of
+// "bulk-approve.v3\n" followed by "<byteLen>:<id>" for every ID in UTF-8 byte order.
+func requestHash(sorted []string) string {
+	var b strings.Builder
+	b.WriteString(Operation)
+	b.WriteByte('\n')
+	for _, id := range sorted {
+		b.WriteString(strconv.Itoa(len(id)))
+		b.WriteByte(':')
+		b.WriteString(id)
+	}
+	sum := sha256.Sum256([]byte(b.String()))
+	return hex.EncodeToString(sum[:])
+}
+
+// sortedCopy returns the IDs ordered by UTF-8 byte order (Go string comparison).
+func sortedCopy(ids []string) []string {
+	out := append([]string(nil), ids...)
+	sort.Strings(out)
+	return out
+}
+
 func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.Handler, error) {
 	approve := func(ctx context.Context, u app.Identity, key string, ids []string) (protocol.Result, bool, error) {
+		// Defence in depth: the adapter already enforces authentication and role.
