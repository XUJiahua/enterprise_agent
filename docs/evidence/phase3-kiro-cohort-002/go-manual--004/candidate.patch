+
+// replay returns the stored result for a completed scope, or 409 if the key was
+// used for a different target set. It performs no writes.
+func replay(ctx context.Context, tx pgx.Tx, u app.Identity, key, hash string) (protocol.Result, bool, error) {
+	var storedHash string
+	var stored []byte
+	err := tx.QueryRow(ctx, `SELECT "requestHash", response::text FROM "ActionRequest" WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+		u.Tenant, u.User, Operation, key).Scan(&storedHash, &stored)
+	if err != nil {
+		// Not visible (should not happen after a committed conflict): treat as transient.
+		return protocol.Result{}, false, err
+	}
+	if storedHash != hash {
+		return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+	}
+	var result protocol.Result
+	if err = json.Unmarshal(stored, &result); err != nil || result.ApprovedIDs == nil {
+		return protocol.Result{}, false, errors.New("stored action response is malformed")
+	}
+	return result, true, nil
+}
