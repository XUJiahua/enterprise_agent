@@ -0,0 +1,16 @@
+package candidate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func TestRequestHash(t *testing.T) {
+	// Input is already in UTF-8 byte order ("z"=0x7a < "é"=0xc3 0xa9).
+	sum := sha256.Sum256([]byte("bulk-approve.v3\n3:abc1:z2:é"))
+	want := hex.EncodeToString(sum[:])
+	if got := requestHash([]string{"abc", "z", "é"}); got != want {
+		t.Fatalf("got %s want %s", got, want)
+	}
+}
