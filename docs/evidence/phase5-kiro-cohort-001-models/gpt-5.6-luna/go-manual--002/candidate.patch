@@ -0,0 +1,99 @@
+package candidate
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+
+	"github.com/XUJiahua/enterprise_agent/internal/app"
+	"github.com/XUJiahua/enterprise_agent/internal/protocol"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const opReopen = "reopen.v5"
+
+func newReopen(pool *pgxpool.Pool) protocol.ItemHandler {
+	return func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		tx, err := pool.Begin(ctx)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		defer tx.Rollback(ctx)
+
+		if _, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		lock, _ := json.Marshal([]string{opReopen, u.Tenant, u.User, key})
+		if _, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, string(lock)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+
+		hash := reopenHash(id, reason)
+		var savedHash string
+		var saved []byte
+		err = tx.QueryRow(ctx, `SELECT "requestHash",response FROM "ActionRequest"
+			WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`, u.Tenant, u.User, opReopen, key).Scan(&savedHash, &saved)
+		switch {
+		case err == nil:
+			if savedHash != hash {
+				return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+			}
+			var result protocol.ItemResult
+			if err = json.Unmarshal(saved, &result); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			if err = tx.Commit(ctx); err != nil {
+				return protocol.ItemResult{}, false, err
+			}
+			return result, true, nil
+		case !errors.Is(err, pgx.ErrNoRows):
+			return protocol.ItemResult{}, false, err
+		}
+
+		result := protocol.ItemResult{ID: id, Status: "submitted"}
+		response, err := json.Marshal(result)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		command, err := tx.Exec(ctx, `UPDATE "Purchase" SET status='submitted'
+			WHERE id=$1 AND "tenantId"=$2 AND "createdBy"=$3 AND status='rejected'`, id, u.Tenant, u.User)
+		if err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if command.RowsAffected() != 1 {
+			return protocol.ItemResult{}, false, &protocol.Rejection{Status: 409}
+		}
+		if _, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit"
+			("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus",reason)
+			VALUES ($1,$2,$3,$4,$5,'rejected','submitted',$6)`, u.Tenant, id, u.User, opReopen, key, reason); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if _, err = tx.Exec(ctx, `INSERT INTO "PurchaseEvent"
+			("tenantId","purchaseId",type,"actorId","idempotencyKey")
+			VALUES ($1,$2,'purchase.reopened',$3,$4)`, u.Tenant, id, u.User, key); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if _, err = tx.Exec(ctx, `INSERT INTO "ActionRequest"
+			("tenantId","actorId",operation,key,"requestHash",response)
+			VALUES ($1,$2,$3,$4,$5,$6::jsonb)`, u.Tenant, u.User, opReopen, key, hash, string(response)); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		if err = tx.Commit(ctx); err != nil {
+			return protocol.ItemResult{}, false, err
+		}
+		return result, false, nil
+	}
+}
+
+func reopenHash(id, reason string) string {
+	h := sha256.New()
+	_, _ = h.Write([]byte(opReopen))
+	_, _ = h.Write([]byte{0})
+	_, _ = h.Write([]byte(id))
+	_, _ = h.Write([]byte{0})
+	_, _ = h.Write([]byte(reason))
+	return hex.EncodeToString(h.Sum(nil))
+}
