-// Batch Actions of the purchase service through the platform Action kernel.
+// Batch and single-target Actions of the purchase service through the platform Action kernel.
 package candidate
 
 import (
@@ -36,5 +36,14 @@ func New(ctx context.Context, pool *pgxpool.Pool, fallback http.Handler) (http.H
 	if err != nil {
 		return nil, err
 	}
-	return protocol.HTTP(protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}, fallback), nil
+	batchRoutes := protocol.Routes{"/purchases/bulk-approve": batch(executor, approveOp), "/purchases/bulk-reject": batch(executor, rejectOp)}
+	itemHandler := func(ctx context.Context, u app.Identity, key, id, reason string) (protocol.ItemResult, bool, error) {
+		done, replayed, err := executor.Run(ctx, u, reopenOp, key, []string{id}, reason)
+		if err != nil {
+			return protocol.ItemResult{}, false, adapt(err)
+		}
+		return protocol.ItemResult{ID: done[0], Status: reopenOp.To}, replayed, nil
+	}
+	itemRouter := protocol.Item("reopen", "requester", itemHandler, fallback)
+	return protocol.HTTP(batchRoutes, itemRouter), nil
 }
