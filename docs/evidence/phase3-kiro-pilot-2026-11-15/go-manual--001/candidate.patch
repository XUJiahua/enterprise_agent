+const operation = "bulk-approve.v3"
+
+// requestHash fingerprints the canonical (sorted, de-duplicated) target set.
+func requestHash(ids []string) (string, error) {
+	b, err := json.Marshal(struct {
+		Operation string   `json:"operation"`
+		IDs       []string `json:"ids"`
+	}{operation, ids})
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:]), nil
+}
