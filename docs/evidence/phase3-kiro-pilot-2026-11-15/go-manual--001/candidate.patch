+func run(ctx context.Context, pool *pgxpool.Pool, u app.Identity, key string, ids []string, hash string, response []byte) (protocol.Result, bool, error) {
+	tx, err := pool.Begin(ctx)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	defer tx.Rollback(ctx)
+	_, err = tx.Exec(ctx, `SELECT set_config('app.tenant',$1,true),set_config('app.user',$2,true),set_config('app.role',$3,true)`, u.Tenant, u.User, u.Role)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+
+	// Claim the idempotency scope first. A concurrent claimant of the same scope
+	// blocks here until the other transaction resolves: on commit we fall through
+	// to replay/409, on rollback our insert proceeds.
+	tag, err := tx.Exec(ctx, `INSERT INTO "ActionRequest" ("tenantId","actorId",operation,key,"requestHash",response)
+		VALUES ($1,$2,$3,$4,$5,$6::jsonb) ON CONFLICT ("tenantId","actorId",operation,key) DO NOTHING`,
+		u.Tenant, u.User, operation, key, hash, string(response))
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	if tag.RowsAffected() == 0 {
+		return replay(ctx, tx, u, key, hash)
+	}
+
+	rows, err := tx.Query(ctx, `SELECT id FROM "Purchase" WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted' ORDER BY id FOR UPDATE`, ids, u.Tenant, u.User)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	eligible := 0
+	for rows.Next() {
+		eligible++
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	if eligible != len(ids) {
+		return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+	}
+	tag, err = tx.Exec(ctx, `UPDATE "Purchase" SET status='approved' WHERE id=ANY($1::text[]) AND "tenantId"=$2 AND "createdBy"<>$3 AND status='submitted'`, ids, u.Tenant, u.User)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	if tag.RowsAffected() != int64(len(ids)) {
+		return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+	}
+	tag, err = tx.Exec(ctx, `INSERT INTO "ApprovalAudit" ("tenantId","purchaseId","approvedBy",operation,"idempotencyKey","fromStatus","toStatus")
+		SELECT $1, t.id, $2, $3, $4, 'submitted', 'approved' FROM unnest($5::text[]) AS t(id)`,
+		u.Tenant, u.User, operation, key, ids)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	if tag.RowsAffected() != int64(len(ids)) {
+		return protocol.Result{}, false, errors.New("audit row count mismatch")
+	}
+	if err = tx.Commit(ctx); err != nil {
+		return protocol.Result{}, false, err
+	}
+	return protocol.Result{ApprovedIDs: ids}, false, nil
+}
+
+// replay returns the committed result for this scope, or 409 if the key was
+// used for a different target set. It performs no writes.
+func replay(ctx context.Context, tx pgx.Tx, u app.Identity, key, hash string) (protocol.Result, bool, error) {
+	var storedHash string
+	var stored []byte
+	err := tx.QueryRow(ctx, `SELECT "requestHash", response::text FROM "ActionRequest"
+		WHERE "tenantId"=$1 AND "actorId"=$2 AND operation=$3 AND key=$4`,
+		u.Tenant, u.User, operation, key).Scan(&storedHash, &stored)
+	if err != nil {
+		return protocol.Result{}, false, err
+	}
+	if storedHash != hash {
+		return protocol.Result{}, false, &protocol.Rejection{Status: 409}
+	}
+	var result protocol.Result
+	if err = json.Unmarshal(stored, &result); err != nil {
+		return protocol.Result{}, false, err
+	}
+	if err = tx.Commit(ctx); err != nil {
+		return protocol.Result{}, false, err
+	}
+	return result, true, nil
+}
